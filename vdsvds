        function updateEnemies() {
            spawnEnemies();
            for (let i = enemies.length - 1; i >= 0; i--) {
                const e = enemies[i];
                e.update();
                e.draw();
                if (e.dead) { enemies.splice(i, 1); continue; }

                if (e.kind === 'boss') {
                    const bd = Math.hypot(player.x - e.x, player.y - e.y);
                    if (bd < player.radius + e.size) {
                        if (player.isDashing) {
                            if (e.invul <= 0) bossHit(e);
                        } else {
                            takeDamage();
                        }
                    }
                    continue;
                }

                if (e.kind === 'laser') {
                    if (e.active() && e.hits(player)) {
                        if (player.isDashing) {
                            if (!e.crossed) {
                                e.crossed = true;
                                addScore(75, player.x, player.y, '#ffffff', '¡CRUCE!');
                                addCombo(1);
                                track('lasercross');
                            }
                        } else {
                            takeDamage();
                        }
                    }
                    continue;
                }

                const dist = Math.hypot(player.x - e.x, player.y - e.y);
                const touch = player.radius + e.size;
                if (dist < touch) {
                    if (player.isDashing) {
                        playSound('hit');
                        for (let p = 0; p < 12; p++) particles.push(new Particle(e.x, e.y, e.color, Math.random() * 5 + 2));
                        addScore(e.points, e.x, e.y, e.color);
                        addCombo(2);
                        track('dashkills');
                        if (e.kind === 'splitter') track('defused');
                        hitStop = 3;
                        rings.push(new Ring(e.x, e.y, e.color, 70));
                    } else {
                        if (e.kind === 'splitter') e.burst();
                        takeDamage();
                    }
                    enemies.splice(i, 1);
                    continue;
                }
                if (!e.grazed && player.invulnerableTimer <= 0 && (player.vx !== 0 || player.vy !== 0) &&
                    dist < touch + grazeMargin()) {
                    e.grazed = true;
                    registerGraze(e);
                }
            }
        }


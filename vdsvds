    <!-- Script Principal del Juego -->
    <script>
        // --- AUDIOS Y SONIDOS (Tone.js Procedimental) ---
        let audioEnabled = lsGet('nv_sfx') !== '0';   // efectos de sonido
        let musicEnabled = lsGet('nv_music') !== '0'; // música
        let vibrationEnabled = lsGet('nv_vib') !== '0'; // vibración (independiente de los efectos)
        let synth, polySynth, noiseSynth;

        function initAudio() {
            if (synth) return;
            try {
                // PolySynth: permite que suenen varios efectos en el mismo instante sin errores de tiempo
                synth = new Tone.PolySynth(Tone.Synth, {
                    oscillator: { type: "triangle" },
                    envelope: { attack: 0.005, decay: 0.1, sustain: 0, release: 0.1 }
                }).toDestination();
                synth.maxPolyphony = 8;
                synth.volume.value = -12;

                polySynth = new Tone.PolySynth(Tone.Synth).toDestination();
                polySynth.volume.value = -10;

                noiseSynth = new Tone.NoiseSynth({
                    noise: { type: "white" },
                    envelope: { attack: 0.005, decay: 0.2, sustain: 0 }
                }).toDestination();
                noiseSynth.volume.value = -14;
            } catch(e) {
                console.log("Audio not supported or blocked");
            }
        }

        // El ruido es monofónico: dos golpes en el mismo frame deben programarse con tiempos distintos
        let lastNoiseTime = 0;

        function playSound(type) {
            if (!audioEnabled || !synth) return;
            try {
                Tone.start();
                if (type === 'gem') {
                    synth.triggerAttackRelease("E5", "16n");
                } else if (type === 'powerup') {
                    polySynth.triggerAttackRelease(["C4", "E4", "G4", "B4"], "16n");
                } else if (type === 'slow') {
                    // Tres notas descendentes en rango audible (los parlantes de celular no reproducen por debajo de ~150 Hz)
                    const t = Tone.now();
                    synth.triggerAttackRelease("G4", "32n", t);
                    synth.triggerAttackRelease("D4", "32n", t + 0.07);
                    synth.triggerAttackRelease("A3", "16n", t + 0.14);
                } else if (type === 'turbo') {
                    synth.triggerAttackRelease("G5", "8n");
                } else if (type === 'graze') {
                    synth.triggerAttackRelease("C6", "32n");
                } else if (type === 'combo') {
                    polySynth.triggerAttackRelease(["E5", "B5"], "16n");
                } else if (type === 'overclock') {
                    synth.triggerAttackRelease("F#2", "8n");
                } else if (type === 'dash') {
                    synth.triggerAttackRelease("A3", "8n");
                } else if (type === 'hit') {
                    const nt = Math.max(Tone.now(), lastNoiseTime + 0.02);
                    lastNoiseTime = nt;
                    noiseSynth.triggerAttackRelease("8n", nt);
                } else if (type === 'gameover') {
                    polySynth.triggerAttackRelease(["C3", "F#3", "A3"], "4n");
                } else if (type === 'win') {
                    polySynth.triggerAttackRelease(["C4", "E4", "G4", "C5"], "8n");
                }
            } catch(e) {}
        }

        // --- VIBRACIÓN (celulares Android) ---
        function vibrate(pattern) {
            if (!vibrationEnabled) return;
            try { if (navigator.vibrate) navigator.vibrate(pattern); } catch (e) {}
        }

        // --- MÚSICA PROCEDURAL (Tone.js) ---
        const CHORDS = [
            { bass: 'A1', notes: ['A3', 'C4', 'E4', 'A4'] },
            { bass: 'F1', notes: ['F3', 'A3', 'C4', 'F4'] },
            { bass: 'C2', notes: ['C4', 'E4', 'G4', 'C5'] },
            { bass: 'G1', notes: ['G3', 'B3', 'D4', 'G4'] }
        ];
        const ARP_PATTERN = [0, 2, 1, 3, 2, 3, 1, 2];
        let musicParts = null;
        let musicIntensity = 0;  // 0 menú/pausa · 1 bajo+bombo · 2 +platillos · 3 +arpegio · 4 todo a tope
        let musicBar = 0;
        let beatPulse = 0;
        let lastBpm = 0;
        let transportWasRunning = false;

        let musicInitFailed = false; // si la música falla una vez, no se reintenta en cada toque
        function initMusic() {
            if (musicParts || musicInitFailed || typeof Tone === 'undefined') return;
            // Los nodos se declaran fuera del try para poder liberarlos si algo falla a medias
            let filter, out, kick, hatFilter, hat, bass, delay, arp, pad, seq;
            try {
                filter = new Tone.Filter(12000, 'lowpass').toDestination();
                out = new Tone.Gain(musicEnabled ? 0.5 : 0).connect(filter);

                kick = new Tone.MembraneSynth({
                    pitchDecay: 0.04, octaves: 5,
                    envelope: { attack: 0.001, decay: 0.25, sustain: 0, release: 0.1 }
                }).connect(out);
                kick.volume.value = -8;

                hatFilter = new Tone.Filter(7000, 'highpass').connect(out);
                hat = new Tone.NoiseSynth({
                    noise: { type: 'white' },
                    envelope: { attack: 0.001, decay: 0.04, sustain: 0 }
                }).connect(hatFilter);
                hat.volume.value = -26;

                bass = new Tone.MonoSynth({
                    oscillator: { type: 'sawtooth' },
                    filter: { Q: 2, type: 'lowpass' },
                    envelope: { attack: 0.005, decay: 0.18, sustain: 0.3, release: 0.1 },
                    filterEnvelope: { attack: 0.005, decay: 0.15, sustain: 0.2, release: 0.2, baseFrequency: 120, octaves: 3 }
                }).connect(out);
                bass.volume.value = -12;

                delay = new Tone.FeedbackDelay({ delayTime: '8n.', feedback: 0.3, wet: 0.25 }).connect(out);
                arp = new Tone.Synth({
                    oscillator: { type: 'square' },
                    envelope: { attack: 0.005, decay: 0.12, sustain: 0, release: 0.05 }
                }).connect(delay);
                arp.volume.value = -18;

                pad = new Tone.PolySynth(Tone.Synth, {
                    oscillator: { type: 'triangle' },
                    envelope: { attack: 0.4, decay: 0.3, sustain: 0.6, release: 1.2 }
                }).connect(out);
                pad.volume.value = -24;

                const steps = Array.from({ length: 16 }, (_, i) => i);
                seq = new Tone.Sequence((time, step) => onMusicStep(time, step), steps, '16n');
                seq.start(0);
                Tone.Transport.bpm.value = 110;

                musicParts = { filter, out, kick, hat, bass, arp, pad, seq };
            } catch (e) {
                // Liberar lo que se alcanzó a crear para no dejar nodos de audio huérfanos
                [seq, pad, arp, delay, bass, hat, hatFilter, kick, out, filter].forEach(n => {
                    try { if (n) n.dispose(); } catch (err) {}
                });
                musicParts = null;
                musicInitFailed = true;
            }
        }

        function onMusicStep(time, step) {
            if (!musicParts || !musicEnabled) return;
            const m = musicParts;
            const I = musicIntensity;
            const chord = CHORDS[musicBar % CHORDS.length];

            if (step % 4 === 0) Tone.Draw.schedule(() => { beatPulse = 1; }, time);
            if (step === 0) m.pad.triggerAttackRelease(chord.notes, '1m', time, 0.6);

            if (I >= 1 && step % 4 === 0) m.kick.triggerAttackRelease('C1', '8n', time);
            if (I >= 2 && step % 4 === 2) m.hat.triggerAttackRelease('32n', time);
            if (I >= 4 && step % 2 === 1) m.hat.triggerAttackRelease('32n', time, 0.5);

            if (I >= 1 && step % 2 === 0) {
                const high = (step === 6 || step === 14);
                const note = high ? Tone.Frequency(chord.bass).transpose(12).toNote() : chord.bass;
                m.bass.triggerAttackRelease(note, '16n', time);
            }

            const arpNote = chord.notes[ARP_PATTERN[step % 8]];
            if (I === 0 && step % 4 === 0) m.arp.triggerAttackRelease(arpNote, '16n', time, 0.3);
            else if (I === 3 && step % 2 === 0) m.arp.triggerAttackRelease(arpNote, '16n', time, 0.7);
            else if (I >= 4) m.arp.triggerAttackRelease(arpNote, '16n', time, 0.8);

            if (step === 15) musicBar++;
        }

        function unlockAudio() {
            try {
                initAudio();
                initMusic();
                if (typeof Tone !== 'undefined') {
                    Tone.start().then(() => {
                        if (Tone.Transport.state !== 'started') Tone.Transport.start();
                    });
                }
            } catch (e) {}
        }

        // El navegador solo permite sonido después de un toque o tecla: se activa con el primero
        const UNLOCK_EVENTS = ['pointerdown', 'touchend', 'click', 'keydown'];
        function onFirstGesture() {
            unlockAudio();
            try {
                if (Tone.context.state === 'running') {
                    UNLOCK_EVENTS.forEach(ev => window.removeEventListener(ev, onFirstGesture));
                }
            } catch (e) {}
        }
        UNLOCK_EVENTS.forEach(ev => window.addEventListener(ev, onFirstGesture, { passive: true }));

        function setMusicMood(i) { musicIntensity = i; }

        function musicMuffle(on) {
            if (!musicParts) return;
            try { musicParts.filter.frequency.rampTo(on ? 650 : 12000, 0.25); } catch (e) {}
        }

        function applyMusicEnabled() {
            if (!musicParts) return;
            try { musicParts.out.gain.rampTo(musicEnabled ? 0.5 : 0, 0.15); } catch (e) {}
        }

        function updateMusicIntensity() {
            let target = [1, 2, 3, 3, 4][Math.min(currentLevelIndex, 4)];
            if (obstacleBoostStage > 0 || combo >= 10) target = 4;
            musicIntensity = target;
            const bpm = 108 + currentLevelIndex * 6 + (obstacleBoostStage > 0 ? 8 : 0);
            if (bpm !== lastBpm) {
                lastBpm = bpm;
                try { Tone.Transport.bpm.rampTo(bpm, 1.5); } catch (e) {}
            }
        }

        function refreshAudioButtons() {
            document.querySelectorAll('.js-sfx-toggle').forEach(b => {
                b.classList.toggle('opacity-50', !audioEnabled);
                b.querySelector('span').classList.toggle('line-through', !audioEnabled);
                b.querySelector('i').className = (audioEnabled ? 'fa-solid fa-volume-high' : 'fa-solid fa-volume-xmark') + ' mr-1';
            });
            document.querySelectorAll('.js-music-toggle').forEach(b => {
                b.classList.toggle('opacity-50', !musicEnabled);
                b.querySelector('span').classList.toggle('line-through', !musicEnabled);
            });
            document.querySelectorAll('.js-vib-toggle').forEach(b => {
                b.classList.toggle('opacity-50', !vibrationEnabled);
                b.querySelector('span').classList.toggle('line-through', !vibrationEnabled);
            });
        }

        // --- SISTEMA DEL JUEGO Y CANVAS ---
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // Estado Global
        let gameState = 'MENU'; // 'MENU', 'PLAYING', 'PAUSED', 'LEVEL_COMPLETE', 'GAMEOVER'

        // Configuración de los 5 Niveles
        const LEVEL_CONFIGS = [
            {
                title: "NIVEL 1: INICIACIÓN",
                targetGems: 10,
                targetScore: 300,
                targetTime: 0,
                description: "Nivel 2: manchas viscosas que aparecen de la nada y rombos naranjas que aceleran a los obstáculos (a cambio de más puntos)."
            },
            {

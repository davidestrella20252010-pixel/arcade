        // --- Misiones diarias (iguales para todo el día, cambian a medianoche) ---
        const MISSION_REWARDS = [15, 25, 40];
        const MISSION_BONUS = 20;
        const MISSION_POOL = [
            { key: 'gems',      mode: 'sum', icon: 'fa-gem',                  text: n => `Junta ${n} cristales`,                     targets: [25, 45, 70] },
            { key: 'grazes',    mode: 'sum', icon: 'fa-bolt',                 text: n => `Haz ${n} raspones`,                        targets: [8, 16, 28] },
            { key: 'dashkills', mode: 'sum', icon: 'fa-burst',                text: n => `Destruye ${n} cuadrados con Dash`,         targets: [4, 9, 16] },
            { key: 'combo',     mode: 'max', icon: 'fa-fire',                 text: n => `Llega a combo ${n} en una partida`,        targets: [8, 14, 22] },
            { key: 'score',     mode: 'max', icon: 'fa-star',                 text: n => `Consigue ${n} puntos en una partida`,      targets: [800, 1800, 3000] },
            { key: 'levels',    mode: 'sum', icon: 'fa-flag-checkered',       text: n => `Completa ${n} ${n === 1 ? 'nivel' : 'niveles'}`, targets: [1, 3, 5] },

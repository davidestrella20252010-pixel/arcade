                this.y += this.vy;
                this.alpha -= 0.02;
                this.scale += (1 - this.scale) * 0.25;
            }

            draw() {
                ctx.save();
                ctx.globalAlpha = Math.max(0, this.alpha);
                ctx.font = 'bold ' + (this.size * this.scale) + 'px Orbitron';
                ctx.fillStyle = this.color;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 8;
                ctx.fillText(this.text, this.x, this.y);
                ctx.restore();
            }
        }

        class Ring {
            constructor(x, y, color, maxR = 90, width = 3) {
                this.x = x;
                this.y = y;
                this.color = color;
                this.maxR = maxR;
                this.width = width;
                this.r = 4;
                this.alpha = 0.9;
            }

            update() {
                this.r += (this.maxR - this.r) * 0.14;
                this.alpha -= 0.035;
            }

            draw() {
                ctx.save();
                ctx.globalAlpha = Math.max(0, this.alpha);
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
                ctx.lineWidth = this.width;
                ctx.strokeStyle = this.color;
                ctx.stroke();
                ctx.restore();
            }
        }

        function updateRings() {
            for (let i = rings.length - 1; i >= 0; i--) {
                const r = rings[i];
                r.update();
                r.draw();
                if (r.alpha <= 0) rings.splice(i, 1);
            }
        }


        // Teclas e Inputs
        const keys = { ArrowUp: false, ArrowDown: false, ArrowLeft: false, ArrowRight: false, w: false, a: false, s: false, d: false, ' ': false };
        let pointerPos = { x: VW / 2, y: VH / 2, isDown: false };

        // --- CONTROLES TÁCTILES: joystick flotante (un lado) + toque = Dash (el otro lado) ---
        const STICK_R = 56;               // radio del joystick (px)
        const STICK_DEAD = 8;             // zona muerta (px)
        const DASH_BUFFER_FRAMES = 9;     // ~150 ms: un toque justo antes de que termine el enfriamiento se guarda
        let leftHanded = lsGet('nv_lefty') === '1';
        const stick = { id: null, ox: 0, oy: 0, x: 0, y: 0 };
        function isMoveSide(x) { return leftHanded ? x >= VW / 2 : x < VW / 2; }
        function resetStick() { stick.id = null; }

        // Distancia mínima entre dos objetos en movimiento durante un frame (de su posición anterior a la actual).
        // Evita que el Dash o los obstáculos rápidos "atraviesen" a otro objeto sin tocarlo entre dos frames.
        function sweptDist(ax0, ay0, ax1, ay1, bx0, by0, bx1, by1) {
            const rx = ax0 - bx0, ry = ay0 - by0;
            const vx = (ax1 - ax0) - (bx1 - bx0), vy = (ay1 - ay0) - (by1 - by0);
            const vv = vx * vx + vy * vy;
            let t = vv > 0 ? -(rx * vx + ry * vy) / vv : 0;
            t = Math.max(0, Math.min(1, t));
            return Math.hypot(rx + vx * t, ry + vy * t);
        }

        class Player {
            constructor() {
                this.x = VW / 2;
                this.y = VH / 2;
                this.radius = 16;
                this.baseSpeed = (7 + (playerData.upgrades.speed * 0.7)) * (1 + perk('swift') * 0.12);
                this.speed = this.baseSpeed;
                this.vx = 0;
                this.vy = 0;
                this.lastDx = 1;
                this.lastDy = 0;
                
                // Efectos de estado (Slow / Turbo / Invulnerable tras daño)
                this.slowTimer = 0;
                this.turboTimer = 0;
                this.invulnerableTimer = 0;

                // Dash
                this.dashCooldownMax = Math.max(40, Math.max(60, 180 - (playerData.upgrades.dash * 25)) * (1 - perk('dashfast') * 0.2)); // frames
                this.dashCooldown = 0;
                this.dashBuffer = 0;
                this.isDashing = false;
                this.dashTimer = 0;

                // Estela
                this.trail = [];
            }

            update() {
                // Posición del frame anterior, para la colisión continua
                this.px = this.x;
                this.py = this.y;

                // Cooldowns y Timers
                if (this.dashCooldown > 0) this.dashCooldown--;
                if (this.slowTimer > 0) this.slowTimer--;
                if (this.turboTimer > 0) this.turboTimer--;
                if (this.invulnerableTimer > 0) this.invulnerableTimer--;

                // Buffer de Dash: un toque durante el enfriamiento se ejecuta apenas esté listo
                if (this.dashBuffer > 0) {
                    this.dashBuffer--;
                    if (this.dashCooldown <= 0 && !this.isDashing) this.triggerDash();
                }

                // Lógica de Dash Activo
                if (this.isDashing) {
                    this.dashTimer--;
                    if (this.dashTimer <= 0) {
                        this.isDashing = false;
                    }
                }

                // Determinar Velocidad Actual con Modificadores
                let effectiveSpeed = this.speed;
                if (this.slowTimer > 0) effectiveSpeed *= 0.45; // Frenado
                if (this.turboTimer > 0) effectiveSpeed *= 2.2; // Turbo de descontrol
                if (this.isDashing) effectiveSpeed = this.speed * 2.8; // Impulso Dash

                // Movimiento por Teclado
                let dx = 0;
                let dy = 0;
                if (keys.ArrowUp || keys.w) dy -= 1;
                if (keys.ArrowDown || keys.s) dy += 1;
                if (keys.ArrowLeft || keys.a) dx -= 1;
                if (keys.ArrowRight || keys.d) dx += 1;

                if (dx !== 0 && dy !== 0) {
                    dx *= 0.7071;
                    dy *= 0.7071;
                }

                // Joystick táctil flotante (analógico)
                if (stick.id !== null && dx === 0 && dy === 0) {
                    const sx = stick.x - stick.ox, sy = stick.y - stick.oy;
                    const slen = Math.hypot(sx, sy);
                    if (slen > STICK_DEAD) {
                        const mag = Math.min(1, (slen - STICK_DEAD) / (STICK_R - STICK_DEAD));
                        dx = sx / slen * mag;
                        dy = sy / slen * mag;
                    }
                }

                // Movimiento por Mouse
                if (pointerPos.isDown && dx === 0 && dy === 0) {
                    const diffX = pointerPos.x - this.x;
                    const diffY = pointerPos.y - this.y;
                    const dist = Math.hypot(diffX, diffY);
                    if (dist > 10) {
                        dx = diffX / dist;
                        dy = diffY / dist;
                    }
                }

                if (dx !== 0 || dy !== 0) {
                    // la dirección se guarda normalizada: el Dash sale a velocidad completa aunque el joystick esté inclinado a medias
                    const dl = Math.hypot(dx, dy);
                    this.lastDx = dx / dl; this.lastDy = dy / dl;
                    if (this.isDashing) { dx = this.lastDx; dy = this.lastDy; }
                }
                else if (this.isDashing) { dx = this.lastDx; dy = this.lastDy; }

                this.vx = dx * effectiveSpeed;
                this.vy = dy * effectiveSpeed;

                this.x += this.vx;
                this.y += this.vy;

                // Colisiones con Bordes de Pantalla
                this.x = Math.max(this.radius, Math.min(VW - this.radius, this.x));
                this.y = Math.max(this.radius, Math.min(VH - this.radius, this.y));

                // Estela FX
                let trailColor = 'rgba(' + currentSkin().rgb + ', ';
                if (this.slowTimer > 0) trailColor = 'rgba(168, 85, 247, ';
                if (this.turboTimer > 0) trailColor = 'rgba(59, 130, 246, ';
                if (this.isDashing) trailColor = 'rgba(255, 0, 127, ';

                this.trail.push({ x: this.x, y: this.y, alpha: 1, radius: this.radius, color: trailColor });
                if (this.trail.length > (this.isDashing || this.turboTimer > 0 ? 16 : 8)) {
                    this.trail.shift();
                }
                this.trail.forEach(t => t.alpha -= 0.08);
            }

            // Devuelve 'ok', 'cooldown' (queda guardado en el buffer) o 'locked' (sin cristales)
            triggerDash() {
                if (this.dashCooldown > 0) {
                    this.dashBuffer = DASH_BUFFER_FRAMES;
                    return 'cooldown';
                }
                this.dashBuffer = 0;
                {
                    if (dashCharges <= 0) {
                        if (collectedGemsThisRun <= 0) { dashBlockedFeedback(); return 'locked'; } // sin cristales: Dash bloqueado
                        collectedGemsThisRun--;                // cada cristal gastado da 2 usos
                        dashCharges = 2;
                    }
                    dashCharges--;
                    this.isDashing = true;
                    this.dashTimer = 12 + upgradeLevel('dashlen') * 3;
                    this.dashCooldown = this.dashCooldownMax;
                    playSound('dash');
                    rings.push(new Ring(this.x, this.y, '#ff007f', 70));
                    vibrate(15);
                    
                    for(let i=0; i<15; i++) {
                        particles.push(new Particle(this.x, this.y, '#ff007f', Math.random()*4+2));
                    }
                    return 'ok';
                }
            }

            draw() {
                // Parpadeo de invulnerabilidad
                if (this.invulnerableTimer > 0 && Math.floor(this.invulnerableTimer / 4) % 2 === 0) {
                    return;
                }

                // Dibujar Estela
                this.trail.forEach(t => {
                    ctx.save();
                    ctx.beginPath();
                    ctx.arc(t.x, t.y, t.radius * 0.8, 0, Math.PI * 2);
                    ctx.fillStyle = t.color + (t.alpha * 0.5) + ')';
                    ctx.fill();
                    ctx.restore();
                });

                // Dibujar Jugador
                ctx.save();
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);

                let coreColor = currentSkin().hex;
                if (this.slowTimer > 0) coreColor = '#a855f7';
                if (this.turboTimer > 0) coreColor = '#3b82f6';
                if (this.isDashing) coreColor = '#ffffff';

                ctx.fillStyle = coreColor;
                ctx.shadowColor = coreColor;
                ctx.shadowBlur = (this.isDashing ? 25 : 15) + Math.min(combo, 30) * 0.6;
                ctx.fill();

                // Núcleo Interior
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius * 0.4, 0, Math.PI * 2);
                ctx.fillStyle = '#ffffff';
                ctx.fill();
                ctx.restore();
            }
        }

        // Zona Viscosa que al pisarla da Slow (Nivel 2+)
        class SlimeZone {
            constructor() {
                // Posición aleatoria, lejos del jugador para que no aparezca encima
                for (let tries = 0; tries < 12; tries++) {
                    this.x = Math.random() * (VW - 150) + 75;
                    this.y = Math.random() * (VH - 150) + 75;
                    if (Math.hypot(player.x - this.x, player.y - this.y) > 140) break;
                }
                this.maxRadius = Math.random() * 30 + 35;
                this.radius = 0;
                this.age = 0;
                this.appearFrames = 14;                        // aparece de golpe
                this.life = 360 + Math.random() * 420;         // dura entre 6 y 13 seg
                this.fadeFrames = 50;
                this.alpha = 1;
                for (let i = 0; i < 14; i++) {
                    particles.push(new Particle(this.x, this.y, '#a855f7', Math.random() * 5 + 2));
                }
            }

            isExpired() {
                return this.age >= this.life;
            }

            update() {
                this.age++;
                const grow = Math.min(1, this.age / this.appearFrames);
                this.radius = this.maxRadius * grow;
                const left = this.life - this.age;
                this.alpha = left < this.fadeFrames ? Math.max(0, left / this.fadeFrames) : 1;

                // Verificar si el jugador entra
                const dist = Math.hypot(player.x - this.x, player.y - this.y);
                if (dist < this.radius + player.radius) {
                    if (player.slowTimer < 10 && !player.isDashing && !perk('antislime')) {
                        player.slowTimer = 40; // Aplica ralentizado por frames
                        playSound('slow');
                    }
                }
            }

            draw() {
                ctx.save();
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                ctx.globalAlpha = this.alpha;
                ctx.fillStyle = 'rgba(168, 85, 247, 0.25)';
                ctx.strokeStyle = 'rgba(168, 85, 247, 0.7)';
                ctx.lineWidth = 2;
                ctx.fill();
                ctx.stroke();
                ctx.restore();
            }
        }

        class Obstacle {
            constructor() {
                const side = Math.floor(Math.random() * 4);
                if (side === 0) {
                    this.x = Math.random() * VW;
                    this.y = -30;
                } else if (side === 1) {
                    this.x = VW + 30;
                    this.y = Math.random() * VH;
                } else if (side === 2) {
                    this.x = Math.random() * VW;
                    this.y = VH + 30;
                } else {
                    this.x = -30;
                    this.y = Math.random() * VH;
                }

                const targetX = player.x + (Math.random() - 0.5) * 200;
                const targetY = player.y + (Math.random() - 0.5) * 200;
                const angle = Math.atan2(targetY - this.y, targetX - this.x);

                // Velocidad aumenta según el Nivel
                const baseSpeed = 2.8 + Math.min(currentLevelIndex, 4) * 0.8 + Math.max(0, currentLevelIndex - 4) * 0.4 + stageExtra() * 0.15;
                this.vx = Math.cos(angle) * baseSpeed;
                this.vy = Math.sin(angle) * baseSpeed;

                this.size = Math.random() * 18 + 15;
                this.rotation = 0;
                this.rotSpeed = (Math.random() - 0.5) * 0.1;
            }

            update() {
                const m = obstacleSpeedMult();
                this.px = this.x;
                this.py = this.y;
                this.x += this.vx * m;
                this.y += this.vy * m;
                this.rotation += this.rotSpeed;
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation);
                ctx.beginPath();
                ctx.rect(-this.size/2, -this.size/2, this.size, this.size);
                const hot = obstacleBoostStage > 0;
                ctx.fillStyle = hot ? '#ff7a00' : '#ff0055';
                ctx.shadowColor = hot ? '#ff7a00' : '#ff0055';
                ctx.shadowBlur = hot ? 20 : 12;
                ctx.fill();
                ctx.lineWidth = 2;
                ctx.strokeStyle = '#ffffff';
                ctx.stroke();
                ctx.restore();
            }

            isOutOfBounds() {
                return (this.x < -60 || this.x > VW + 60 || this.y < -60 || this.y > VH + 60);
            }
        }

        class Collectible {
            constructor(type = 'gem') {
                this.x = Math.random() * (VW - 80) + 40;
                this.y = Math.random() * (VH - 80) + 40;
                this.type = type; // 'gem', 'multiplier', 'turbo', 'heart'
                
                if (type === 'gem') {
                    this.radius = 8;
                    this.color = '#eab308';
                } else if (type === 'multiplier') {
                    this.radius = 11;
                    this.color = '#a855f7';
                } else if (type === 'turbo') {
                    this.radius = 10;
                    this.color = '#3b82f6';
                } else if (type === 'heart') {
                    this.radius = 12;
                    this.color = '#ef4444';
                } else if (type === 'overclock') {
                    this.radius = 11;
                    this.color = '#ff7a00';
                    this.life = 600; // desaparece a los 10 seg si no lo tocas
                }

                this.pulse = 0;
            }

            update() {
                this.pulse += 0.08;
                if (this.life !== undefined) this.life--;
                if (this.type === 'overclock' || this.type === 'turbo') return; // el imán no atrae lo perjudicial

                const magnetRadius = (60 + (playerData.upgrades.magnet * 35)) * (1 + perk('magnetp') * 0.4);
                const dist = Math.hypot(player.x - this.x, player.y - this.y);

                if (dist < magnetRadius) {
                    const angle = Math.atan2(player.y - this.y, player.x - this.x);
                    const pull = (1 - dist / magnetRadius) * 8;
                    this.x += Math.cos(angle) * pull;
                    this.y += Math.sin(angle) * pull;
                }
            }

            draw() {
                if (this.type === 'overclock') {
                    if (this.life < 120 && Math.floor(this.life / 6) % 2 === 0) return; // parpadea antes de irse
                    const sz = this.radius * (1 + Math.sin(this.pulse) * 0.2) * 1.3;
                    ctx.save();
                    ctx.translate(this.x, this.y);
                    ctx.rotate(this.pulse * 0.5);
                    ctx.beginPath();
                    ctx.moveTo(0, -sz); ctx.lineTo(sz, 0); ctx.lineTo(0, sz); ctx.lineTo(-sz, 0);
                    ctx.closePath();
                    ctx.fillStyle = this.color;
                    ctx.shadowColor = this.color;
                    ctx.shadowBlur = 18;
                    ctx.fill();
                    ctx.lineWidth = 2;
                    ctx.strokeStyle = '#ffffff';
                    ctx.stroke();
                    ctx.restore();
                    return;
                }
                ctx.save();
                ctx.beginPath();
                const scale = 1 + Math.sin(this.pulse) * 0.2;
                ctx.arc(this.x, this.y, this.radius * scale, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 15;
                ctx.fill();
                
                if (this.type === 'heart') {
                    ctx.fillStyle = '#ffffff';
                    ctx.font = '12px sans-serif';
                    ctx.fillText('♥', this.x - 4, this.y + 4);
                }

                ctx.restore();
            }
        }

        class Particle {
            constructor(x, y, color, speed) {
                this.x = x;
                this.y = y;
                this.color = color;
                const angle = Math.random() * Math.PI * 2;
                this.vx = Math.cos(angle) * speed;
                this.vy = Math.sin(angle) * speed;
                this.alpha = 1;
                this.size = Math.random() * 4 + 2;
                this.decay = Math.random() * 0.03 + 0.015;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.alpha -= this.decay;
            }

            draw() {
                ctx.save();
                ctx.globalAlpha = Math.max(0, this.alpha);
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.fill();
                ctx.restore();
            }
        }

        class FloatingText {
            constructor(x, y, text, color, size = 16) {
                this.x = x;
                this.y = y;
                this.text = text;
                this.color = color;
                this.size = size;
                this.scale = 1.7;
                this.alpha = 1;
                this.vy = -1.5;

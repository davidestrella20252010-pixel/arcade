        function startGame(mode) {
            if (typeof mode === 'string') gameMode = mode;
            runFrames = 0; nearRecordShown = false; dailyRewardThisRun = 0;
            if (gameMode === 'infinite') infAttemptStreak++;
            if (gameMode === 'daily') { ensureDaily(); mut = dailyMutators(); } else { mut = {}; }

        // --- Enemigos nuevos ---
        function randomEdgePoint() {
            const side = Math.floor(Math.random() * 4);
            if (side === 0) return { x: Math.random() * VW, y: -40 };
            if (side === 1) return { x: VW + 40, y: Math.random() * VH };
            if (side === 2) return { x: Math.random() * VW, y: VH + 40 };
            return { x: -40, y: Math.random() * VH };
        }
        function normAngle(a) { while (a > Math.PI) a -= Math.PI * 2; while (a < -Math.PI) a += Math.PI * 2; return a; }

        // Perseguidor: triángulo fucsia que gira hacia ti, pero se apaga a los 10 seg
        class Seeker {
            constructor() {
                const p = randomEdgePoint();
                this.kind = 'seeker';
                this.x = p.x; this.y = p.y;
                this.px = this.x; this.py = this.y;
                this.angle = Math.atan2(player.y - this.y, player.x - this.x);
                this.speed = 3.5 + Math.min(currentLevelIndex, 4) * 0.3 + Math.max(0, currentLevelIndex - 4) * 0.25;
                this.turn = 0.05;
                this.size = 12;
                this.life = 600;
                this.color = '#d946ef';
                this.points = 150;
            }
            update() {
                this.px = this.x; this.py = this.y;
                const want = Math.atan2(player.y - this.y, player.x - this.x);
                const diff = normAngle(want - this.angle);
                this.angle += Math.max(-this.turn, Math.min(this.turn, diff));
                const m = obstacleSpeedMult();
                this.x += Math.cos(this.angle) * this.speed * m;
                this.y += Math.sin(this.angle) * this.speed * m;
                this.life--;
                if (this.life <= 0) {
                    this.dead = true;
                    for (let i = 0; i < 8; i++) particles.push(new Particle(this.x, this.y, this.color, Math.random() * 3 + 1));
                }
            }
            draw() {
                ctx.save();
                ctx.globalAlpha = this.life < 60 ? Math.max(0.2, this.life / 60) : 1;
                ctx.translate(this.x, this.y);
                ctx.rotate(this.angle);
                ctx.beginPath();
                ctx.moveTo(this.size * 1.3, 0);
                ctx.lineTo(-this.size, this.size * 0.9);
                ctx.lineTo(-this.size * 0.5, 0);
                ctx.lineTo(-this.size, -this.size * 0.9);
                ctx.closePath();
                ctx.fillStyle = this.color;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 14;
                ctx.fill();
                ctx.lineWidth = 2;
                ctx.strokeStyle = '#ffffff';
                ctx.stroke();
                ctx.restore();
            }
        }

        // Bomba divisora: hexágono verde azulado que estalla en 4 fragmentos. Con Dash se desactiva.
        class Splitter {
            constructor() {
                const p = randomEdgePoint();
                this.kind = 'splitter';
                this.x = p.x; this.y = p.y;
                this.px = this.x; this.py = this.y;
                const tx = player.x + (Math.random() - 0.5) * 160;
                const ty = player.y + (Math.random() - 0.5) * 160;
                const a = Math.atan2(ty - this.y, tx - this.x);
                const sp = 1.5 + currentLevelIndex * 0.2;
                this.vx = Math.cos(a) * sp;
                this.vy = Math.sin(a) * sp;
                this.size = 22;
                this.fuse = 150 + Math.random() * 40;
                this.maxFuse = this.fuse;
                this.rot = 0;
                this.color = '#14b8a6';
                this.points = 200;
            }
            update() {
                this.px = this.x; this.py = this.y;
                const m = obstacleSpeedMult();
                this.x += this.vx * m;
                this.y += this.vy * m;
                this.rot += 0.02;
                this.fuse--;
                if (this.fuse <= 0) { this.burst(); this.dead = true; }
                else if (this.x < -140 || this.x > VW + 140 || this.y < -140 || this.y > VH + 140) this.dead = true;
            }
            burst() {
                for (let k = 0; k < 4; k++) {
                    const a = this.rot + Math.PI / 4 + k * Math.PI / 2;
                    const f = new Obstacle();
                    f.x = this.x; f.y = this.y; f.px = this.x; f.py = this.y;
                    f.vx = Math.cos(a) * 3.4;
                    f.vy = Math.sin(a) * 3.4;
                    f.size = 12;
                    obstacles.push(f);
                }
                playSound('hit');
                screenShake = Math.max(screenShake, 5);
                vibrate(25);
                rings.push(new Ring(this.x, this.y, this.color, 90, 3));
                for (let i = 0; i < 12; i++) particles.push(new Particle(this.x, this.y, this.color, Math.random() * 4 + 1));
            }
            draw() {
                const left = this.fuse / this.maxFuse;
                const blink = this.fuse < 45 && Math.floor(this.fuse / 5) % 2 === 0;
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rot);
                ctx.beginPath();
                for (let i = 0; i < 6; i++) {
                    const a = i * Math.PI / 3;
                    const r = this.size * (1 + (1 - left) * 0.12);
                    ctx.lineTo(Math.cos(a) * r, Math.sin(a) * r);
                }
                ctx.closePath();
                ctx.fillStyle = blink ? '#ffffff' : this.color;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 16;
                ctx.fill();
                ctx.lineWidth = 2;
                ctx.strokeStyle = '#ffffff';
                ctx.stroke();
                ctx.restore();
                // anillo que se cierra: cuánto falta para estallar
                ctx.save();
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size + 8, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * left);
                ctx.lineWidth = 2;
                ctx.strokeStyle = 'rgba(255,255,255,0.7)';
                ctx.stroke();
                ctx.restore();
            }
        }

        // Láser: avisa con una línea punteada y luego dispara un rayo que cruza toda la pantalla
        class Laser {
            constructor() {
                this.kind = 'laser';
                this.vertical = Math.random() < 0.5;
                const base = this.vertical ? player.x : player.y;
                const lim = this.vertical ? VW : VH;
                this.pos = Math.max(30, Math.min(lim - 30, base + (Math.random() - 0.5) * 260));
                this.t = 0;
                this.warn = 75;
                this.fire = 22;
                this.thick = 34;
                this.color = '#ff2e97';
            }
            active() { return this.t >= this.warn && this.t < this.warn + this.fire; }
            update() {
                this.t++;
                if (this.t === this.warn) { playSound('overclock'); screenShake = Math.max(screenShake, 6); vibrate(30); }
                if (this.t >= this.warn + this.fire) this.dead = true;
            }
            hits(p) {
                const d = this.vertical ? Math.abs(p.x - this.pos) : Math.abs(p.y - this.pos);
                return d < this.thick / 2 + p.radius * 0.8;
            }
            line(w) {
                ctx.beginPath();
                if (this.vertical) { ctx.moveTo(this.pos, 0); ctx.lineTo(this.pos, VH); }
                else { ctx.moveTo(0, this.pos); ctx.lineTo(VW, this.pos); }
                ctx.lineWidth = w;
                ctx.stroke();
            }
            draw() {
                ctx.save();
                if (this.t < this.warn) {
                    ctx.globalAlpha = 0.35 + 0.35 * Math.sin(this.t * 0.5);
                    ctx.strokeStyle = '#ff8fb8';
                    ctx.setLineDash([10, 10]);
                    this.line(2);
                    ctx.setLineDash([]);
                    ctx.globalAlpha = 0.07;
                    ctx.strokeStyle = this.color;
                    this.line(this.thick);
                } else {
                    const k = 1 - (this.t - this.warn) / this.fire;
                    ctx.shadowColor = this.color;
                    ctx.shadowBlur = 28;
                    ctx.globalAlpha = 0.55 + 0.45 * k;
                    ctx.strokeStyle = this.color;
                    this.line(this.thick);
                    ctx.strokeStyle = '#ffffff';
                    this.line(this.thick * 0.35);
                }
                ctx.restore();
            }
        }

        // ================= JEFES (base común combinable) =================
        // Cada jefe tiene una lista de patrones. Se combinan según la configuración del nivel.
        // Los proyectiles usan el mismo sistema de colisión que el resto de enemigos.
        class Shot {
            constructor(x, y, angle, speed, color) {
                this.kind = 'shot';
                this.x = x; this.y = y;
                this.px = x; this.py = y;
                this.vx = Math.cos(angle) * speed;
                this.vy = Math.sin(angle) * speed;
                this.size = 7;
                this.points = 60;
                this.color = color;
                this.life = 360;
            }
            update() {
                this.px = this.x; this.py = this.y;
                const m = obstacleSpeedMult();
                this.x += this.vx * m;
                this.y += this.vy * m;
                this.life--;
                if (this.life <= 0 || this.x < -40 || this.x > VW + 40 || this.y < -40 || this.y > VH + 40) this.dead = true;
            }
            draw() {
                ctx.save();
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 10;
                ctx.fill();
                ctx.restore();
            }
        }

        const BOSS_PATTERNS = {
            // Anillo de proyectos en todas direcciones
            ring(b) {
                const n = b.phase === 2 ? 14 : 10;
                const offset = b.t * 0.05;
                for (let i = 0; i < n; i++) {
                    enemies.push(new Shot(b.x, b.y, offset + (i / n) * Math.PI * 2, 3, b.color));
                }
            },
            // Abanico de disparos hacia el jugador
            aimed(b) {
                const base = Math.atan2(player.y - b.y, player.x - b.x);
                const count = b.phase === 2 ? 5 : 3;
                for (let i = 0; i < count; i++) {
                    enemies.push(new Shot(b.x, b.y, base + (i - (count - 1) / 2) * 0.18, 5.5, b.color));
                }
            },
            // Muro horizontal que cae, con un hueco de 3 casillas en posición aleatoria
            wall(b) {
                const slots = 20;
                const slot = VW / slots;
                const gapStart = Math.floor(Math.random() * (slots - 3));
                for (let i = 0; i <= slots; i++) {
                    if (i >= gapStart && i < gapStart + 3) continue;
                    enemies.push(new Shot(i * slot, -10, Math.PI / 2, 3.2, b.color));
                }
            },
            // Invoca un Perseguidor (hasta 3 a la vez)
            summon() {
                if (enemies.filter(e => e.kind === 'seeker').length < 3) enemies.push(new Seeker());
            }
        };

        class Boss {
            constructor(cfg) {
                this.kind = 'boss';
                this.name = cfg.name;
                this.hp = cfg.hp;
                this.maxHp = cfg.hp;
                this.patterns = cfg.patterns;
                this.color = cfg.color;
                this.size = 42;
                this.points = 1000;
                this.x = VW / 2;
                this.y = -60;   // entra desde arriba
                this.t = 0;
                this.step = 0;
                this.phase = 1;
                this.fireTimer = 120;
                this.invul = 0; // frames sin recibir daño tras un golpe
            }
            update() {
                this.t++;
                this.y += (140 - this.y) * 0.03;
                this.x = VW / 2 + Math.sin(this.t / 90) * Math.min(VW * 0.35, 260);
                if (this.invul > 0) this.invul--;

                if (this.phase === 1 && this.hp <= this.maxHp / 2) {
                    this.phase = 2;
                    floatingTexts.push(new FloatingText(this.x - 60, this.y + 60, '¡FASE 2!', this.color, 20));
                }

                this.fireTimer--;
                if (this.fireTimer <= 0) {
                    const name = this.patterns[this.step % this.patterns.length];
                    this.step++;
                    BOSS_PATTERNS[name](this);
                    this.fireTimer = this.phase === 2 ? 84 : 120;
                }
            }
            draw() {
                ctx.save();
                const flash = this.invul > 0 && Math.floor(this.invul / 4) % 2 === 0;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = flash ? '#ffffff' : this.color;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 25;
                ctx.globalAlpha = 0.85;
                ctx.fill();
                ctx.lineWidth = 3;
                ctx.strokeStyle = '#ffffff';
                ctx.stroke();

                // Nombre y barra de vida encima del jefe
                const bw = 120, bx = this.x - bw / 2, by = this.y - this.size - 22;
                ctx.shadowBlur = 0;
                ctx.globalAlpha = 1;
                ctx.font = '11px Orbitron, sans-serif';
                ctx.textAlign = 'center';
                ctx.fillStyle = '#ffffff';
                ctx.fillText(this.name, this.x, by - 6);
                ctx.fillStyle = 'rgba(0,0,0,0.6)';
                ctx.fillRect(bx, by, bw, 8);
                ctx.fillStyle = this.color;
                ctx.fillRect(bx, by, bw * Math.max(0, this.hp / this.maxHp), 8);
                ctx.restore();
            }
        }


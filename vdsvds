        }

        function checkLevelObjectives() {
            if (isEndless()) { waveTick(); return; }
            const config = LEVEL_CONFIGS[currentLevelIndex];
            let gemsOk = collectedGemsThisRun >= config.targetGems;
            let scoreOk = gameScore >= config.targetScore;
            let timeOk = gameTime >= config.targetTime;

            if (gemsOk && scoreOk && timeOk) {
                if (config.boss) {
                    if (!bossSpawned) spawnBoss(config.boss);
                } else {
                    triggerLevelComplete();
                }
            }
        }

        function bankProgress() {
            bankedScore += Math.floor(gameScore);
            bankedGems += collectedGemsThisRun;
            playerData.gems += collectedGemsThisRun;
            if (bankedScore > playerData.highScore) playerData.highScore = bankedScore;
            savePlayerData();
        }

        function triggerLevelComplete() {
            gameState = 'LEVEL_COMPLETE';
            playSound('win');
            setMusicMood(0);
            vibrate([40, 40, 90]);
            rings.push(new Ring(player.x, player.y, '#00f3ff', Math.max(VW, VH) * 0.6, 5));
            bankProgress();

            const config = LEVEL_CONFIGS[currentLevelIndex];
            const isLast = currentLevelIndex === LEVEL_CONFIGS.length - 1;
            track('levels');
            if (isLast) track('wins');
            if (!levelDamageTaken) unlockAch('untouched');
            checkAchievements();
            savePlayerData();
            document.getElementById('level-cleared-text').innerText = isLast ? '¡JUEGO COMPLETADO!' : `${config.title} COMPLETADO`;

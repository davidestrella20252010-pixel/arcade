                description: "¡Felicidades! Has derrotado a Némesis y dominado Neon Velocity.",
                boss: { name: "NÉMESIS", hp: 14, color: "#ff2e97", patterns: ["ring", "aimed", "wall", "summon"] }
            }
        ];

        // Datos del Jugador Guardados
        function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

        let savedUpg = null;
        try { savedUpg = JSON.parse(lsGet('nv_upgrades')); } catch (e) {}

        function lsJSON(k, fb) {
            try { const v = JSON.parse(lsGet(k)); return (v && typeof v === 'object') ? v : fb; } catch (e) { return fb; }
        }

        // FASE 2: alias del jugador (solo letras, números, espacio, _ y -; máx. 12)
        function sanitizeName(s) { return String(s || '').replace(/[^\p{L}\p{N} _\-]/gu, '').trim().slice(0, 12); }

        let playerData = {
            highScore: parseInt(lsGet('nv_highscore')) || 0,
            gems: parseInt(lsGet('nv_gems')) || 0,
            upgrades: Object.assign({ speed: 0, dash: 0, magnet: 0, dashlen: 0, combo: 0, shield: 0 }, savedUpg || {}),
            stats: lsJSON('nv_stats', {}),
            ach: lsJSON('nv_ach', {}),
            missions: lsJSON('nv_missions', { date: '', list: [], bonus: false }),
            owned: lsJSON('nv_owned', {}),
            skin: lsGet('nv_skin') || 'cyan',
            inf: Object.assign({ score: 0, wave: 0, times: [] }, lsJSON('nv_inf', {})),
            daily: Object.assign({ date: '', best: 0, played: false, streak: 0, lastDate: '' }, lsJSON('nv_daily', {})),
            name: sanitizeName(lsGet('nv_name') || ''),   // FASE 2
            lastRun: lsJSON('nv_lastrun', null)           // FASE 2: datos de la última partida
        };
        function playerName() { return playerData.name || 'PILOTO'; }

        // UI Elements
        const menuUI = document.getElementById('main-menu');
        const gameOverUI = document.getElementById('game-over');
        const levelCompleteUI = document.getElementById('level-complete-modal');
        const hudUI = document.getElementById('hud');
        const shopModal = document.getElementById('shop-modal');
        const pausedUI = document.getElementById('pause-modal');

        const scoreDisplay = document.getElementById('score-display');
        const levelDisplay = document.getElementById('level-display');
        const livesDisplay = document.getElementById('lives-display');
        const objectiveDisplay = document.getElementById('objective-display');
        const gemsDisplay = document.getElementById('gems-display');
        const dashBar = document.getElementById('dash-bar');
        const dashChargesEl = document.getElementById('dash-charges');
        const highScoreDisplay = document.getElementById('high-score');
        const totalGemsDisplay = document.getElementById('total-gems');

        // Ajuste de Canvas Dinámico
        let VW = window.innerWidth;
        let VH = window.innerHeight;
        function resizeCanvas() {
            const dpr = Math.min(window.devicePixelRatio || 1, 2); // tope 2: más fluido en celulares
            VW = window.innerWidth;
            VH = window.innerHeight;
            canvas.width = Math.round(VW * dpr);
            canvas.height = Math.round(VH * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // --- CLASES Y OBJETOS DEL JUEGO ---
        let player = null;
        let currentLevelIndex = 0;
        let playerLives = 3;
        let obstacles = [];
        let collectibles = [];
        let hazmatZones = []; // Zonas ralentizadoras para Nivel 2+
        let slimeSpawnTimer = 0;
        let obstacleSpawnTimer = 0;
        let obstacleBoostStage = 0; // 0 a 3: cuántos cristales de peligro se tocaron
        let obstacleBoostTimer = 0;

        // --- COMBOS, RASPONES Y BONO DE PELIGRO ---

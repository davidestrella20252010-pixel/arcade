                ms.bonus = true;
                playerData.gems += MISSION_BONUS;
                toast('fa-gift', '¡BONO DIARIO!', '+' + MISSION_BONUS + ' cristales por completar las 3', '#ffc400');
            }
            checkAchievements();
            savePlayerData();
            totalGemsDisplay.innerText = playerData.gems;
            playSound('powerup');
            vibrate(20);
            renderMissions();
            updateMenuBadges();
        }

        // --- Panel de logros ---
        function renderAchievements() {
            const total = ACHIEVEMENTS.length;
            const got = ACHIEVEMENTS.filter(a => playerData.ach[a.id]).length;
            document.getElementById('ach-summary').innerText = `${got} / ${total} desbloqueados`;
            document.getElementById('ach-list').innerHTML = ACHIEVEMENTS.map(a => {
                const done = !!playerData.ach[a.id];
                const sk = SKINS.find(s => s.ach === a.id);
                const cur = a.stat ? Math.min(statVal(a.stat), a.target) : 0;
                const bar = (a.stat && !done)
                    ? `<div class="h-1.5 bg-slate-800 rounded-full overflow-hidden mt-2"><div class="h-full rounded-full bg-cyan-400" style="width:${cur / a.target * 100}%"></div></div>
                       <div class="text-[11px] font-orbitron text-slate-400 mt-1">${cur} / ${a.target}</div>` : '';
                return `<div class="bg-slate-900/80 p-3.5 rounded-xl border ${done ? 'border-yellow-500/40' : 'border-slate-800'} ${done ? '' : 'opacity-80'}">
                    <div class="flex items-start gap-3">
                        <i class="fa-solid ${done ? a.icon : 'fa-lock'} ${done ? 'text-yellow-300' : 'text-slate-500'} mt-1 w-5 text-center"></i>
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-bold ${done ? 'text-yellow-200' : 'text-white'} leading-tight">${a.name}</div>
                            <div class="text-xs text-slate-400 leading-snug">${a.desc}</div>
                            ${sk ? `<div class="text-[11px] text-cyan-300 mt-0.5">Desbloquea el estilo ${sk.name}</div>` : ''}
                            ${bar}
                        </div>
                        <div class="shrink-0 font-orbitron text-xs font-bold ${done ? 'text-emerald-400' : 'text-yellow-300'} whitespace-nowrap">
                            ${done ? '<i class="fa-solid fa-check mr-1"></i>OK' : '+' + a.reward + ' <i class="fa-solid fa-gem text-[10px]"></i>'}
                        </div>
                    </div></div>`;
            }).join('');
        }

        // --- Tienda ---
        let shopTab = 'upg';
        let shopMsgTimer = null;
        function showShopMsg(text) {
            const el = document.getElementById('shop-msg');
            el.innerText = text;
            clearTimeout(shopMsgTimer);
            if (text) shopMsgTimer = setTimeout(() => { el.innerText = ''; }, 2200);
        }

        function renderShop() {
            document.getElementById('shop-gems').innerText = playerData.gems;
            const on = 'flex-1 py-3 rounded-lg font-orbitron font-bold text-xs bg-yellow-500/20 border border-yellow-500/60 text-yellow-300';
            const off = 'flex-1 py-3 rounded-lg font-orbitron font-bold text-xs bg-slate-900 border border-slate-700 text-slate-400';
            document.getElementById('shop-tab-upg').className = shopTab === 'upg' ? on : off;
            document.getElementById('shop-tab-skin').className = shopTab === 'skin' ? on : off;
            const list = document.getElementById('shop-list');
            const scroll = list.scrollTop;
            if (shopTab === 'upg') {
                list.innerHTML = Object.keys(UPGRADES).map(key => {
                    const u = UPGRADES[key];
                    const lvl = upgradeLevel(key);
                    const maxed = lvl >= u.max;
                    const poor = !maxed && playerData.gems < upgradeCost(key);
                    const pips = '●'.repeat(lvl) + '○'.repeat(u.max - lvl);
                    return `<div class="bg-slate-900/80 p-3.5 rounded-xl border border-slate-800 flex justify-between items-center gap-3">
                        <div class="min-w-0">
                            <h4 class="font-bold text-white text-sm">${u.name}</h4>
                            <p class="text-xs text-slate-400">${u.desc}</p>
                            <span class="text-[11px] font-orbitron text-cyan-400 tracking-widest">${pips}${maxed ? ' MAX' : ''}</span>
                        </div>
                        <button data-buy="${key}" ${maxed ? 'disabled' : ''} class="shrink-0 min-w-[76px] px-3 py-3 bg-yellow-500/20 border border-yellow-500/50 rounded-lg font-orbitron text-xs text-yellow-300 font-bold ${maxed || poor ? 'opacity-50' : ''}">
                            ${maxed ? 'MAX' : upgradeCost(key) + ' <i class="fa-solid fa-gem text-[10px]"></i>'}
                        </button>
                    </div>`;
                }).join('');
            } else {
                list.innerHTML = SKINS.map(s => {
                    const owned = skinOwned(s);
                    const equipped = playerData.skin === s.id;
                    const ach = s.ach ? ACHIEVEMENTS.find(a => a.id === s.ach) : null;
                    let btn;
                    if (equipped) btn = `<button disabled class="shrink-0 min-w-[96px] px-3 py-3 bg-cyan-500/20 border border-cyan-400/60 rounded-lg font-orbitron text-xs text-cyan-300 font-bold">EQUIPADO</button>`;
                    else if (owned) btn = `<button data-skin="${s.id}" class="shrink-0 min-w-[96px] px-3 py-3 bg-slate-800 border border-slate-600 rounded-lg font-orbitron text-xs text-white font-bold">EQUIPAR</button>`;
                    else if (ach) btn = `<button disabled class="shrink-0 min-w-[96px] px-3 py-3 bg-slate-900 border border-slate-700 rounded-lg font-orbitron text-xs text-slate-500 font-bold"><i class="fa-solid fa-lock mr-1"></i>LOGRO</button>`;
                    else btn = `<button data-skin="${s.id}" class="shrink-0 min-w-[96px] px-3 py-3 bg-yellow-500/20 border border-yellow-500/50 rounded-lg font-orbitron text-xs text-yellow-300 font-bold ${playerData.gems < s.cost ? 'opacity-50' : ''}">${s.cost} <i class="fa-solid fa-gem text-[10px]"></i></button>`;
                    return `<div class="bg-slate-900/80 p-3.5 rounded-xl border ${equipped ? 'border-cyan-500/50' : 'border-slate-800'} flex justify-between items-center gap-3">
                        <div class="flex items-center gap-3 min-w-0">
                            <span class="shrink-0 inline-block w-9 h-9 rounded-full" style="background:${s.hex};box-shadow:0 0 12px ${s.hex}"></span>
                            <div class="min-w-0">
                                <h4 class="font-bold text-white text-sm">${s.name}</h4>
                                <p class="text-xs text-slate-400">${ach && !owned ? 'Logro: ' + ach.name : (owned ? 'Color de núcleo y estela' : 'Estilo de nave')}</p>
                            </div>
                        </div>${btn}
                    </div>`;
                }).join('');
            }
            list.scrollTop = scroll;
        }

        function buyUpgrade(key) {
            const u = UPGRADES[key];
            if (!u || upgradeLevel(key) >= u.max) return;
            const cost = upgradeCost(key);
            if (playerData.gems < cost) {
                showShopMsg(`Te faltan ${cost - playerData.gems} cristales`);
                return;
            }
            playerData.gems -= cost;
            playerData.upgrades[key] = upgradeLevel(key) + 1;
            savePlayerData();
            showShopMsg('');
            renderShop();
            updateUI();
            playSound('powerup');
            unlockAch('upgraded');
            renderShop();
        }

        function skinAction(id) {
            const s = SKINS.find(x => x.id === id);
            if (!s) return;
            if (!skinOwned(s)) {
                if (s.ach) { showShopMsg('Se desbloquea con un logro'); return; }
                if (playerData.gems < s.cost) { showShopMsg(`Te faltan ${s.cost - playerData.gems} cristales`); return; }
                playerData.gems -= s.cost;
                playerData.owned[s.id] = 1;
            }
            playerData.skin = s.id;
            savePlayerData();
            showShopMsg('');
            renderShop();
            updateUI();
            playSound('powerup');
        }

        function openPanel(id) { document.getElementById(id).classList.remove('hidden'); }

        btnShop.addEventListener('click', () => {
            showShopMsg('');
            renderShop();
            openPanel('shop-modal');
        });
        btnCloseShop.addEventListener('click', () => { shopModal.classList.add('hidden'); });
        document.getElementById('shop-tab-upg').addEventListener('click', () => { shopTab = 'upg'; renderShop(); });
        document.getElementById('shop-tab-skin').addEventListener('click', () => { shopTab = 'skin'; renderShop(); });
        document.getElementById('btn-missions').addEventListener('click', () => { renderMissions(); openPanel('missions-modal'); });
        document.getElementById('btn-achievements').addEventListener('click', () => { renderAchievements(); openPanel('ach-modal'); });

        document.addEventListener('click', (e) => {
            const close = e.target.closest('[data-close]');
            if (close) { document.getElementById(close.dataset.close).classList.add('hidden'); return; }
            const claim = e.target.closest('[data-claim]');
            if (claim) { claimMission(parseInt(claim.dataset.claim, 10)); return; }
            const buy = e.target.closest('[data-buy]');
            if (buy) { buyUpgrade(buy.dataset.buy); return; }
            const sk = e.target.closest('[data-skin]');
            if (sk) skinAction(sk.dataset.skin);
        });
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') ['shop-modal', 'missions-modal', 'ach-modal', 'daily-modal'].forEach(id => document.getElementById(id).classList.add('hidden'));
        });

        // --- Guardado ---
        function savePlayerData() {
            lsSet('nv_highscore', playerData.highScore);
            lsSet('nv_gems', playerData.gems);
            lsSet('nv_upgrades', JSON.stringify(playerData.upgrades));
            lsSet('nv_stats', JSON.stringify(playerData.stats));
            lsSet('nv_ach', JSON.stringify(playerData.ach));
            lsSet('nv_missions', JSON.stringify(playerData.missions));
            lsSet('nv_owned', JSON.stringify(playerData.owned));
            lsSet('nv_skin', playerData.skin);
            lsSet('nv_inf', JSON.stringify(playerData.inf));
            lsSet('nv_daily', JSON.stringify(playerData.daily));
            lsSet('nv_name', playerData.name);
            lsSet('nv_lastrun', JSON.stringify(playerData.lastRun));
            statsDirty = false;
        }
        window.addEventListener('pagehide', savePlayerData);
        document.addEventListener('visibilitychange', () => { if (document.hidden) savePlayerData(); });

        function drawShield() {
            if (runShields <= 0 || !player) return;
            const t = performance.now() / 300;
            ctx.save();
            ctx.beginPath();
            ctx.arc(player.x, player.y, player.radius + 9 + Math.sin(t) * 1.5, 0, Math.PI * 2);
            ctx.lineWidth = 1.5 + runShields * 0.7;
            ctx.strokeStyle = 'rgba(160, 240, 255, 0.85)';
            ctx.shadowColor = '#7df9ff';
            ctx.shadowBlur = 12;
            ctx.stroke();
            ctx.restore();
        }

        // Efectos y música (menú y pausa)
        document.addEventListener('click', (e) => {
            if (e.target.closest('.js-sfx-toggle')) {
                audioEnabled = !audioEnabled;
                lsSet('nv_sfx', audioEnabled ? '1' : '0');
                refreshAudioButtons();
            } else if (e.target.closest('.js-music-toggle')) {
                musicEnabled = !musicEnabled;
                lsSet('nv_music', musicEnabled ? '1' : '0');
                applyMusicEnabled();
                refreshAudioButtons();
            } else if (e.target.closest('.js-vib-toggle')) {
                vibrationEnabled = !vibrationEnabled;
                lsSet('nv_vib', vibrationEnabled ? '1' : '0');
                refreshAudioButtons();
                if (vibrationEnabled) vibrate(30); // pequeña muestra al activarla
            }
        });

        // ================= FASE 3: TARJETA COMPARTIBLE Y RESUMEN =================
        const MODE_LABELS = { campaign: 'CAMPAÑA', infinite: 'MODO INFINITO', daily: 'RETO DIARIO' };
        let shareBlobPromise = null; // la tarjeta se prepara al terminar la partida, así compartir es instantáneo

        function fmtClock(sec) {
            sec = Math.max(0, Math.round(sec || 0));
            return Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0');
        }
        function dayNumber(dateStr) { // número del reto diario: días desde el 1 de enero de 2026
            const p = String(dateStr || '').split('-').map(Number);
            if (p.length !== 3 || p.some(isNaN)) return 1;
            return Math.max(1, Math.floor((Date.UTC(p[0], p[1] - 1, p[2]) - Date.UTC(2026, 0, 1)) / 86400000) + 1);
        }
        function stageLabel(run) { return (run.mode === 'campaign' ? 'NIVEL ' : 'OLEADA ') + run.stage; }

        function buildShareText(run) {
            if (!run) return '';
            const frac = run.mode === 'campaign' ? run.stage / LEVEL_CONFIGS.length : Math.min(1, run.sec / 180);
            const filled = Math.max(0, Math.min(10, Math.round(frac * 10)));
            const bar = '🟦'.repeat(filled) + '⬛'.repeat(10 - filled);
            const title = run.mode === 'daily'
                ? `NEON VELOCITY · Reto #${dayNumber(run.date)}`
                : `NEON VELOCITY · ${MODE_LABELS[run.mode] || ''}`;
            const lines = [
                title,
                bar,
                `🏆 ${run.score} pts · 🔥 combo x${run.combo}`,
                `🎯 ${run.grazes} raspones · ⏱ ${fmtClock(run.sec)}`
            ];
            if (run.mode === 'daily') {
                lines.push(run.dailyDone ? `✅ Reto completado · racha ${playerData.daily.streak}` : '❌ Reto no completado');
            }
            lines.push('¿Puedes superarme?');
            if (/^https?:/.test(location.href)) lines.push(location.href.split('#')[0]);
            return lines.join('\n');
        }

        function roundRectPath(g, x, y, w, h, r) {
            g.beginPath();
            g.moveTo(x + r, y);
            g.arcTo(x + w, y, x + w, y + h, r);
            g.arcTo(x + w, y + h, x, y + h, r);
            g.arcTo(x, y + h, x, y, r);
            g.arcTo(x, y, x + w, y, r);
            g.closePath();
        }

        // Dibuja la tarjeta vertical 9:16 (1080x1920) y devuelve una promesa con la imagen PNG
        async function buildShareCard(run) {
            try { await Promise.all([document.fonts.load('900 100px Orbitron'), document.fonts.load('700 40px Orbitron')]); } catch (e) {}
            const W = 1080, H = 1920;
            const c = document.createElement('canvas');
            c.width = W; c.height = H;
            const g = c.getContext('2d');
            const FONT = 'Orbitron, "Arial Black", sans-serif';

            const bg = g.createLinearGradient(0, 0, 0, H);
            bg.addColorStop(0, '#05050d');
            bg.addColorStop(1, '#1a0630');
            g.fillStyle = bg;
            g.fillRect(0, 0, W, H);
            g.strokeStyle = 'rgba(0, 243, 255, 0.07)';
            g.lineWidth = 2;
            for (let x = 0; x <= W; x += 60) { g.beginPath(); g.moveTo(x, 0); g.lineTo(x, H); g.stroke(); }
            for (let y = 0; y <= H; y += 60) { g.beginPath(); g.moveTo(0, y); g.lineTo(W, y); g.stroke(); }
            const glow = g.createRadialGradient(W / 2, 900, 50, W / 2, 900, 700);
            glow.addColorStop(0, 'rgba(255, 0, 127, 0.22)');
            glow.addColorStop(1, 'rgba(255, 0, 127, 0)');
            g.fillStyle = glow;
            g.fillRect(0, 0, W, H);

            g.save();
            g.shadowColor = '#00f3ff';
            g.shadowBlur = 30;
            g.strokeStyle = 'rgba(0, 243, 255, 0.8)';
            g.lineWidth = 4;
            roundRectPath(g, 40, 40, W - 80, H - 80, 40);
            g.stroke();
            g.restore();

            const text = (t, x, y, size, color, weight, glowPx) => {
                g.save();
                g.font = (weight || 700) + ' ' + size + 'px ' + FONT;
                g.textAlign = 'center';
                g.textBaseline = 'middle';
                g.fillStyle = color;
                if (glowPx) { g.shadowColor = color; g.shadowBlur = glowPx; }
                g.fillText(t, x, y);
                g.restore();
            };

            text('NEON VELOCITY', W / 2, 230, 96, '#00f3ff', 900, 30);
            text('ARCADE CYBERPUNK', W / 2, 305, 30, '#94a3b8', 700);
            text(MODE_LABELS[run.mode] || 'PARTIDA', W / 2, 430, 46, '#ff2e97', 700, 18);
            text('PILOTO', W / 2, 540, 28, '#94a3b8', 700);
            text(String(run.name || 'PILOTO').toUpperCase(), W / 2, 610, 64, '#ffffff', 900, 10);

            // Puntaje grande (se reduce si es muy largo)
            const scoreStr = String(run.score);
            let ss = 230;
            g.font = '900 ' + ss + 'px ' + FONT;
            while (g.measureText(scoreStr).width > 900 && ss > 80) { ss -= 10; g.font = '900 ' + ss + 'px ' + FONT; }
            text('PUNTUACIÓN', W / 2, 770, 40, '#94a3b8', 700);
            text(scoreStr, W / 2, 940, ss, '#00f3ff', 900, 40);
            text(stageLabel(run), W / 2, 1060, 46, '#ff2e97', 700, 14);

            const tiles = [
                ['MEJOR COMBO', 'x' + run.combo, '#00f3ff'],
                ['RASPONES', String(run.grazes), '#ff2e97'],
                ['CRISTALES', String(run.gems), '#facc15'],
                ['TIEMPO', fmtClock(run.sec), '#a3e635']
            ];
            tiles.forEach((t, i) => {
                const x = 90 + (i % 2) * 480;
                const y = 1150 + Math.floor(i / 2) * 250;
                g.save();
                g.fillStyle = 'rgba(10, 10, 26, 0.75)';
                g.strokeStyle = t[2];
                g.lineWidth = 3;
                g.shadowColor = t[2];
                g.shadowBlur = 18;
                roundRectPath(g, x, y, 420, 200, 28);
                g.fill();
                g.stroke();
                g.restore();
                text(t[0], x + 210, y + 55, 30, '#94a3b8', 700);
                text(t[1], x + 210, y + 135, 84, t[2], 900, 16);
            });

            if (run.mode === 'daily' && run.dailyDone) text('RETO COMPLETADO', W / 2, 1720, 44, '#34d399', 900, 16);
            text('¿PUEDES SUPERARME?', W / 2, 1800, 56, '#ffffff', 900, 12);
            text(String(run.date || ''), W / 2, 1865, 30, '#64748b', 700);

            return new Promise((resolve) => c.toBlob((b) => resolve(b), 'image/png'));
        }

        function downloadBlob(blob, name) {
            const a = document.createElement('a');
            const url = URL.createObjectURL(blob);
            a.href = url;
            a.download = name;
            document.body.appendChild(a);
            a.click();
            a.remove();
            setTimeout(() => URL.revokeObjectURL(url), 2000);
        }

        async function shareCardNow() {
            const run = playerData.lastRun;
            if (!run) return;
            try {
                if (!shareBlobPromise) shareBlobPromise = buildShareCard(run).catch(() => null);
                const blob = await shareBlobPromise;
                if (!blob) throw new Error('sin imagen');
                const file = new File([blob], 'neon-velocity.png', { type: 'image/png' });
                if (navigator.canShare && navigator.canShare({ files: [file] })) {
                    await navigator.share({ files: [file], text: buildShareText(run) });
                    return;
                }
                downloadBlob(blob, 'neon-velocity-' + run.score + '.png');
                toast('fa-download', 'TARJETA GUARDADA', 'Búscala en tu carpeta de descargas', '#00f3ff');
            } catch (e) {
                if (e && e.name === 'AbortError') return; // el jugador canceló el menú de compartir
                toast('fa-triangle-exclamation', 'NO SE PUDO COMPARTIR', 'Prueba con COPIAR RESUMEN', '#ff2e97');
            }
        }

        async function copySummaryNow() {
            const run = playerData.lastRun;
            if (!run) return;
            const txt = buildShareText(run);
            let ok = false;
            try { await navigator.clipboard.writeText(txt); ok = true; } catch (e) {}
            if (!ok) { // respaldo para navegadores sin portapapeles moderno
                const ta = document.createElement('textarea');
                ta.value = txt;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try { ok = document.execCommand('copy'); } catch (e) {}
                ta.remove();
            }
            if (ok) toast('fa-copy', 'RESUMEN COPIADO', 'Pégalo en tu red social favorita', '#34d399');
            else toast('fa-triangle-exclamation', 'NO SE PUDO COPIAR', 'Tu navegador bloqueó el portapapeles', '#ff2e97');
        }

        // Iniciar bucle de renderizado
        window.onload = function() {
            highScoreDisplay.innerText = playerData.highScore;
            totalGemsDisplay.innerText = playerData.gems;
            // Si el dispositivo no vibra (iPhone, PC), el botón no tiene sentido y se quita
            if (!navigator.vibrate) document.querySelectorAll('.js-vib-toggle').forEach(b => b.remove());
            ensureMissions();
            updateMenuBadges();
            updateModeStats();
            refreshAudioButtons();
            // Controles táctiles: el modo zurdo solo tiene sentido en pantallas táctiles
            if (!IS_MOBILE) document.querySelectorAll('.js-hand-toggle').forEach(b => b.remove());
            applyHandedness();
            refreshHandButtons();
            renderLegend('legend-menu');
            renderLegend('legend-pause');
            // FASE 2: campo de alias
            const nameInput = document.getElementById('player-name');
            nameInput.value = playerData.name;
            nameInput.addEventListener('keydown', (e) => { e.stopPropagation(); if (e.key === 'Enter') nameInput.blur(); });
            nameInput.addEventListener('keyup', (e) => e.stopPropagation());
            nameInput.addEventListener('change', () => {
                playerData.name = sanitizeName(nameInput.value);
                nameInput.value = playerData.name;
                savePlayerData();
            });
            // FASE 3: compartir
            document.getElementById('btn-share').addEventListener('click', shareCardNow);
            document.getElementById('btn-copy').addEventListener('click', copySummaryNow);
            document.getElementById('btn-start').focus();
            gameLoop();
        };
    </script>
</body>

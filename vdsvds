<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neon Velocity - Arcade Cyberpunk</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tone.js para efectos de sonido procedimentales -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- FontAwesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
    
    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            touch-action: none;
        }
        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: #05050d;
            color: #ffffff;
            overflow: hidden;
        }
        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }
        .neon-glow-cyan {
            text-shadow: 0 0 10px rgba(0, 243, 255, 0.8), 0 0 20px rgba(0, 243, 255, 0.4);
        }
        .neon-glow-pink {
            text-shadow: 0 0 10px rgba(255, 0, 127, 0.8), 0 0 20px rgba(255, 0, 127, 0.4);
        }
        .neon-box-cyan {
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.4), inset 0 0 15px rgba(0, 243, 255, 0.2);
            border: 1px solid rgba(0, 243, 255, 0.6);
        }
        .neon-box-pink {
            box-shadow: 0 0 15px rgba(255, 0, 127, 0.4), inset 0 0 15px rgba(255, 0, 127, 0.2);
            border: 1px solid rgba(255, 0, 127, 0.6);
        }
        .glass-panel {
            background: rgba(10, 10, 26, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .scrollable, .scrollable * { touch-action: pan-y; }
        button:focus-visible { outline: 2px solid #00f3ff; outline-offset: 3px; }
        /* FASE 2: el campo de alias sí debe poder seleccionarse y escribirse */
        input, textarea { user-select: text; -webkit-user-select: text; touch-action: auto; }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        /* Respaldo si el CDN de Tailwind no carga: los modales ocultos siguen ocultos */
        .hidden { display: none !important; }
        .opacity-0 { opacity: 0; }
        /* Altura real visible en móviles (la barra de direcciones no recorta el juego) */
        body.h-screen { height: 100vh; height: 100dvh; }
        /* El botón DASH táctil se muestra según el tipo de pantalla, no por su ancho (tablets incluidas) */
        #mobile-controls { display: none; }
        @media (pointer: coarse), (hover: none) {
            #mobile-controls { display: block; }
        }
        @keyframes nv-shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
        .nv-shake { animation: nv-shake .25s; }
        .nv-toast { opacity: 0; transform: translateY(8px); transition: opacity .25s, transform .25s; }
        .nv-toast.show { opacity: 1; transform: none; }
        #btn-next-level:disabled { opacity: .45; cursor: not-allowed; transform: none; }
        #objective-panel { opacity: 0.4; } /* transparente para ver los proyectiles que llegan por la izquierda */
    </style>
</head>
<body class="w-screen h-screen flex flex-col justify-center items-center relative overflow-hidden select-none">

    <!-- Canvas Principal del Juego -->
    <div id="game-container" class="relative w-full h-full">
        <canvas id="gameCanvas"></canvas>

        <!-- Pantalla de Menú Principal -->
        <div id="main-menu" class="absolute inset-0 flex flex-col items-center justify-center glass-panel z-30 p-6">
            <div class="text-center max-w-md w-full bg-slate-950/80 p-8 rounded-2xl border border-cyan-500/30 neon-box-cyan max-h-[95vh] overflow-y-auto scrollable">
                <h1 class="text-5xl font-orbitron font-black text-cyan-400 mb-2 neon-glow-cyan tracking-wider">NEON VELOCITY</h1>
                <p class="text-xs font-orbitron tracking-widest text-slate-400 mb-6">ARCADE CYBERPUNK</p>

                <div class="space-y-3 mb-6 bg-slate-900/60 p-4 rounded-xl border border-slate-800 text-left">
                    <div class="flex justify-between items-center text-sm gap-3">
                        <span class="text-slate-400">Piloto</span>
                        <input id="player-name" type="text" maxlength="12" placeholder="PILOTO" autocomplete="off" spellcheck="false" class="w-36 bg-slate-950/80 border border-cyan-500/40 rounded-lg px-2 py-1 text-right font-orbitron font-bold text-cyan-300 text-sm uppercase placeholder-slate-600 focus:outline-none focus:border-cyan-300">
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-400">Récord Campaña</span>
                        <span id="high-score" class="font-orbitron font-bold text-cyan-400 text-lg">0</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-400">Récord Infinito</span>
                        <span id="inf-best" class="font-orbitron font-bold text-pink-300 text-lg">0</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-400">Reto de hoy</span>
                        <span id="daily-best" class="font-orbitron font-bold text-pink-300 text-lg">—</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-400">Total Cristales</span>
                        <span id="total-gems" class="font-orbitron font-bold text-yellow-400 text-lg">0</span>
                    </div>
                </div>

                <div class="space-y-3">
                    <button id="btn-start" class="w-full py-4 rounded-xl bg-gradient-to-r from-cyan-500 to-pink-500 text-white font-orbitron font-bold text-lg uppercase tracking-wider hover:scale-105 active:scale-95 transition-all shadow-lg">
                        <i class="fa-solid fa-play mr-2"></i>JUGAR AHORA
                    </button>
                    
                    <div class="flex space-x-3">
                        <button id="btn-infinite" class="flex-1 py-3 rounded-xl bg-slate-900/90 border border-pink-500/40 text-pink-300 font-orbitron font-bold text-sm hover:bg-pink-500/20 transition-all">
                            <i class="fa-solid fa-infinity mr-1.5"></i>INFINITO
                        </button>
                        <button id="btn-daily" class="relative flex-1 py-3 rounded-xl bg-slate-900/90 border border-pink-500/40 text-pink-300 font-orbitron font-bold text-sm hover:bg-pink-500/20 transition-all">
                            <i class="fa-solid fa-calendar-day mr-1.5"></i>RETO DIARIO
                            <span id="daily-badge" class="hidden absolute -top-2 -right-2 min-w-[22px] h-[22px] px-1 rounded-full bg-yellow-400 text-slate-900 text-[11px] leading-[22px] font-bold">!</span>
                        </button>
                    </div>

                    <div class="flex space-x-3">
                        <button id="btn-missions" class="relative flex-1 py-3 rounded-xl bg-slate-900/90 border border-cyan-500/40 text-cyan-300 font-orbitron font-bold text-sm hover:bg-cyan-500/20 transition-all">
                            <i class="fa-solid fa-bullseye mr-1.5"></i>MISIONES
                            <span id="missions-badge" class="hidden absolute -top-2 -right-2 min-w-[22px] h-[22px] px-1 rounded-full bg-pink-500 text-white text-[11px] leading-[22px] font-bold">0</span>
                        </button>
                        <button id="btn-achievements" class="flex-1 py-3 rounded-xl bg-slate-900/90 border border-yellow-500/40 text-yellow-300 font-orbitron font-bold text-sm hover:bg-yellow-500/20 transition-all">
                            <i class="fa-solid fa-trophy mr-1.5"></i>LOGROS
                        </button>
                    </div>

                    <div class="flex space-x-3">
                        <button id="btn-shop" class="flex-1 py-3 rounded-xl bg-slate-900/90 border border-yellow-500/40 text-yellow-300 font-orbitron font-bold text-sm hover:bg-yellow-500/20 transition-all">
                            <i class="fa-solid fa-store mr-1.5"></i>TIENDA
                        </button>
                        <button class="js-sfx-toggle flex-1 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-slate-300 font-orbitron font-bold text-xs hover:bg-slate-800 transition-all flex items-center justify-center">
                            <i class="fa-solid fa-volume-high mr-1"></i><span>EFECTOS</span>
                        </button>
                        <button class="js-music-toggle flex-1 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-slate-300 font-orbitron font-bold text-xs hover:bg-slate-800 transition-all flex items-center justify-center">
                            <i class="fa-solid fa-music mr-1"></i><span>MÚSICA</span>
                        </button>
                    </div>
                    <button class="js-vib-toggle w-full py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-slate-300 font-orbitron font-bold text-xs hover:bg-slate-800 transition-all flex items-center justify-center">
                        <i class="fa-solid fa-mobile-screen-button mr-1"></i><span>VIBRACIÓN</span>
                    </button>
                    <button class="js-hand-toggle w-full py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-slate-300 font-orbitron font-bold text-xs hover:bg-slate-800 transition-all flex items-center justify-center">
                        <i class="fa-solid fa-hand mr-1"></i><span>MODO ZURDO</span>
                    </button>
                </div>

                <details class="mt-5 text-left bg-slate-900/60 rounded-xl border border-slate-800">
                    <summary class="cursor-pointer px-4 py-2.5 text-xs font-orbitron text-cyan-400">¿QUÉ HACE CADA COSA?</summary>
                    <div id="legend-menu" class="px-4 pb-3 space-y-2.5 max-h-44 overflow-y-auto scrollable"></div>
                </details>

                <div class="mt-5 text-[11px] text-slate-500 font-orbitron">
                    Muévete con <span class="text-cyan-400">WASD / Flechas</span>, o mantén presionado el <span class="text-cyan-400">clic izquierdo</span> para ir hacia ese punto.<br>
                    Dash: <span class="text-pink-400">ESPACIO / Click Der.</span> Cada cristal da 2 usos.<br>
                    En celular: <span class="text-cyan-400">lado izquierdo</span> = joystick, <span class="text-pink-400">lado derecho</span> = toca para Dash (modo zurdo disponible).<br>
                    Pausa: <span class="text-yellow-300">ESC / P</span>
                </div>
            </div>
        </div>

        <!-- HUD Superior en Juego -->
        <div id="hud" class="absolute top-4 left-4 right-4 flex justify-between items-start pointer-events-none transition-opacity duration-300 opacity-0">
            <div class="flex flex-col space-y-2">
                <div class="flex items-center space-x-6">
                    <!-- Puntuación -->
                    <div>
                        <div class="text-xs uppercase tracking-widest text-cyan-400 font-bold">Puntuación</div>
                        <div id="score-display" class="text-3xl font-orbitron font-extrabold text-white neon-glow-cyan">0</div>
                    </div>
                    <!-- Nivel Actual -->
                    <div>
                        <div class="text-xs uppercase tracking-widest text-purple-400 font-bold"><span id="level-label">Nivel</span></div>
                        <div id="level-display" class="text-2xl font-orbitron font-bold text-purple-400">1</div>
                    </div>
                    <!-- Vidas (Corazones) -->
                    <div>
                        <div class="text-xs uppercase tracking-widest text-red-400 font-bold">Vidas</div>
                        <div id="lives-display" class="text-2xl text-red-500 tracking-wider">
                            <i class="fa-solid fa-heart"></i>
                            <i class="fa-solid fa-heart"></i>
                            <i class="fa-solid fa-heart"></i>
                        </div>
                    </div>
                </div>

                <!-- Requisito del Nivel Actual -->
                <div id="objective-panel" class="bg-slate-900/80 px-3 py-2 rounded-lg border border-cyan-500/30 text-xs font-orbitron text-cyan-300 w-56">
                    <span id="objective-title" class="text-slate-400 block text-[10px] mb-1.5">OBJETIVO DE NIVEL</span>
                    <div id="objective-display" class="space-y-1.5"></div>
                </div>

                <!-- Combo -->
                <div id="combo-box" class="hidden w-56 bg-slate-900/80 px-3 py-2 rounded-lg border border-cyan-500/30 font-orbitron">
                    <div class="flex items-baseline justify-between">
                        <span class="text-[10px] text-slate-400">COMBO</span>
                        <span id="combo-mult" class="text-xs text-cyan-300 font-bold">x1.0</span>
                    </div>
                    <div id="combo-count" class="text-2xl font-black text-white leading-none neon-glow-cyan">0</div>
                    <div class="h-1.5 bg-slate-800 rounded-full overflow-hidden mt-1.5">
                        <div id="combo-bar" class="h-full bg-cyan-400 rounded-full" style="width:100%"></div>
                    </div>
                </div>
            </div>

            <!-- Monedas y Dash Bar -->
            <div class="flex flex-col items-end space-y-2">
                <button id="btn-pause" aria-label="Pausa" class="pointer-events-auto w-9 h-9 rounded-full bg-slate-900/80 border border-cyan-500/40 text-cyan-300 hover:bg-cyan-500/20 transition-all">
                    <i class="fa-solid fa-pause"></i>
                </button>
                <div class="flex items-center space-x-2 bg-slate-900/80 px-3 py-1.5 rounded-full border border-yellow-500/50">
                    <i class="fa-solid font-bold text-yellow-400 fa-gem"></i>
                    <span id="gems-display" class="font-orbitron font-bold text-yellow-300">0</span>
                </div>
                <div id="danger-badge" class="hidden px-3 py-1 rounded-full bg-orange-500/20 border border-orange-400/60 text-orange-300 font-orbitron text-xs font-bold"></div>
                <!-- Usos de Dash disponibles -->
                <div id="dash-charges" class="text-xs font-orbitron font-bold tracking-wider text-cyan-300"></div>
                <!-- Barra de enfriamiento Dash -->
                <div class="w-32 bg-slate-900/80 h-3 rounded-full overflow-hidden border border-cyan-500/30">
                    <div id="dash-bar" class="h-full bg-gradient-to-r from-cyan-500 to-pink-500 transition-all duration-75 w-full"></div>
                </div>
            </div>
        </div>

        <!-- Pantalla de Nivel Completado -->
        <div id="level-complete-modal" class="absolute inset-0 flex flex-col items-center justify-center glass-panel z-30 p-6 hidden">
            <div class="text-center max-w-md w-full bg-slate-950/90 p-6 rounded-2xl border border-cyan-500/40 neon-box-cyan max-h-[95vh] overflow-y-auto scrollable">
                <h2 id="level-complete-title" class="text-4xl font-orbitron font-black text-cyan-400 mb-1 neon-glow-cyan">¡NIVEL COMPLETADO!</h2>
                <p id="level-cleared-text" class="text-sm font-orbitron tracking-widest text-slate-300 mb-6">NIVEL 1 SUPERADO</p>

                <div class="bg-slate-900/80 p-4 rounded-xl mb-6 text-center border border-slate-800">
                    <p id="next-level-label" class="text-xs text-slate-400 mb-1">LO NUEVO EN EL SIGUIENTE NIVEL:</p>
                    <p id="next-level-description" class="text-sm font-bold text-yellow-300">Trampas viscosas que te frenarán.</p>
                </div>

                <div id="perk-box-lc" class="hidden mb-5 text-left">
                    <p class="text-xs font-orbitron tracking-widest text-cyan-400 mb-2 text-center">ELIGE UNA MEJORA PARA LA PARTIDA</p>
                    <div id="perk-choices" class="space-y-2"></div>
                </div>

                <button id="btn-next-level" class="w-full py-4 rounded-xl bg-gradient-to-r from-cyan-500 to-emerald-500 text-white font-orbitron font-bold text-lg uppercase tracking-wider hover:scale-105 active:scale-95 transition-all shadow-lg">
                    CONTINUAR AL SIGUIENTE NIVEL <i class="fa-solid fa-arrow-right ml-2"></i>
                </button>
            </div>
        </div>

        <!-- Pantalla de Game Over -->
        <div id="game-over" class="absolute inset-0 flex flex-col items-center justify-center glass-panel z-30 p-6 hidden">
            <div class="text-center max-w-md w-full bg-slate-950/80 p-8 rounded-2xl border border-pink-500/30 neon-box-pink max-h-[95vh] overflow-y-auto scrollable">
                <h2 class="text-4xl font-orbitron font-black text-pink-500 mb-1 neon-glow-pink">SOBRECARGA</h2>
                <p class="text-xs font-orbitron tracking-widest text-slate-400 mb-4">SISTEMA COLAPSADO</p>
                <div id="daily-reward" class="hidden mb-4 py-1.5 rounded-lg bg-emerald-400/15 border border-emerald-400/50 text-emerald-300 font-orbitron font-bold text-xs"></div>
                <div id="new-record" class="hidden mb-4 py-1.5 rounded-lg bg-yellow-400/15 border border-yellow-400/50 text-yellow-300 font-orbitron font-bold text-sm">¡NUEVO RÉCORD!</div>
                <div id="near-record" class="hidden mb-4 py-1.5 rounded-lg bg-pink-500/15 border border-pink-500/50 text-pink-300 font-orbitron font-bold text-xs"></div>

                <div id="inf-times" class="hidden mb-4 p-4 rounded-xl bg-slate-900/60 border border-cyan-500/30 text-left">
                    <div class="text-[10px] font-orbitron tracking-widest text-slate-400 mb-2">MEJORES TIEMPOS</div>
                    <div id="inf-times-list" class="space-y-1 font-orbitron text-sm"></div>
                    <div id="inf-run-line" class="mt-3 text-xs font-orbitron text-cyan-300"></div>
                    <div id="inf-streak-line" class="mt-1 text-[11px] font-orbitron text-slate-400"></div>
                </div>
                <div class="space-y-3 bg-slate-900/60 p-4 rounded-xl mb-6 text-left border border-slate-800">
                    <div class="flex justify-between items-center">
                        <span class="text-slate-400 text-sm">Puntuación Final</span>
                        <span id="final-score" class="font-orbitron text-xl font-bold text-cyan-400">0</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-400 text-sm">Mejor Puntuación</span>
                        <span id="best-score-gameover" class="font-orbitron text-lg font-bold text-white">0</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-400 text-sm">Mejor combo</span>
                        <span id="best-combo" class="font-orbitron text-md font-bold text-cyan-300">0</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-400 text-sm">Raspones</span>
                        <span id="graze-count" class="font-orbitron text-md font-bold text-cyan-300">0</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span id="reached-label" class="text-slate-400 text-sm">Nivel alcanzado</span>
                        <span id="reached-level" class="font-orbitron text-md font-bold text-purple-400">1</span>
                    </div>
                    <div class="flex justify-between items-center pt-2 border-t border-slate-800">
                        <span class="text-slate-400 text-sm">Gemas Recolectadas</span>
                        <span id="gained-gems" class="font-orbitron text-md font-bold text-yellow-400">+0</span>
                    </div>
                </div>

                <div class="flex space-x-3">
                    <button id="btn-restart" class="flex-1 py-3.5 rounded-xl bg-gradient-to-r from-pink-500 to-purple-600 text-white font-orbitron font-bold text-md uppercase tracking-wider hover:scale-105 active:scale-95 transition-all shadow-lg">
                        <i class="fa-solid fa-rotate-right mr-2"></i>REINTENTAR
                    </button>
                    <button id="btn-menu" class="px-5 py-3.5 rounded-xl bg-slate-800 text-slate-300 hover:text-white font-orbitron font-bold text-md hover:bg-slate-700 transition-all">
                        <i class="fa-solid fa-house"></i>
                    </button>
                </div>
                <div class="flex space-x-3 mt-3">
                    <button id="btn-share" class="flex-1 py-2.5 rounded-xl bg-slate-900/90 border border-cyan-500/40 text-cyan-300 font-orbitron font-bold text-xs hover:bg-cyan-500/20 transition-all">
                        <i class="fa-solid fa-share-nodes mr-1.5"></i>COMPARTIR TARJETA
                    </button>
                    <button id="btn-copy" class="flex-1 py-2.5 rounded-xl bg-slate-900/90 border border-emerald-500/40 text-emerald-300 font-orbitron font-bold text-xs hover:bg-emerald-500/20 transition-all">
                        <i class="fa-solid fa-copy mr-1.5"></i>COPIAR RESUMEN
                    </button>
                </div>
                <p class="mt-4 text-[11px] text-slate-500 font-orbitron">Presiona <span class="text-pink-400">R</span> para reintentar al instante</p>
            </div>
        </div>

        <!-- Panel de Tienda / Mejoras -->
        <div id="shop-modal" class="absolute inset-0 flex flex-col items-center justify-center glass-panel z-40 p-4 hidden">
            <div class="max-w-md w-full bg-slate-950/90 p-6 rounded-2xl border border-yellow-500/40 max-h-[90vh] flex flex-col">
                <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-800">
                    <h2 class="text-2xl font-orbitron font-bold text-yellow-400 flex items-center">
                        <i class="fa-solid fa-bolt mr-2"></i> MEJORAS CIBERNÉTICAS
                    </h2>
                    <button id="btn-close-shop" class="text-slate-400 hover:text-white text-xl">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="flex items-center justify-between bg-slate-900 px-4 py-2 rounded-xl mb-4">
                    <span class="text-xs text-slate-400 uppercase font-orbitron">Tus Cristales:</span>
                    <span id="shop-gems" class="font-orbitron font-bold text-yellow-400 text-lg">0</span>
                </div>
                <p id="shop-msg" role="status" class="text-xs font-orbitron text-center text-red-400 h-4 -mt-2 mb-3"></p>

                <div class="flex gap-2 mb-3">
                    <button id="shop-tab-upg" class="flex-1 py-3 rounded-lg font-orbitron font-bold text-xs">MEJORAS</button>
                    <button id="shop-tab-skin" class="flex-1 py-3 rounded-lg font-orbitron font-bold text-xs">ESTILOS</button>
                </div>

                <!-- Lista de Mejoras / Estilos -->
                <div id="shop-list" class="space-y-3 overflow-y-auto pr-1 flex-1 min-h-0 mb-2 scrollable"></div>
            </div>
        </div>

        <!-- Misiones diarias -->
        <div id="missions-modal" class="absolute inset-0 flex flex-col items-center justify-center glass-panel z-40 p-4 hidden">
            <div class="max-w-md w-full bg-slate-950/90 p-5 rounded-2xl border border-cyan-500/40 neon-box-cyan max-h-[90vh] flex flex-col">
                <div class="flex justify-between items-center mb-3 pb-3 border-b border-slate-800">
                    <h2 class="text-xl font-orbitron font-bold text-cyan-400"><i class="fa-solid fa-bullseye mr-2"></i>MISIONES DIARIAS</h2>
                    <button data-close="missions-modal" aria-label="Cerrar" class="w-11 h-11 text-slate-400 hover:text-white text-xl"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <p id="missions-reset" class="text-[11px] font-orbitron text-slate-400 mb-3"></p>
                <div id="missions-list" class="space-y-3 overflow-y-auto pr-1 flex-1 min-h-0 scrollable"></div>
            </div>
        </div>

        <!-- Logros -->
        <div id="ach-modal" class="absolute inset-0 flex flex-col items-center justify-center glass-panel z-40 p-4 hidden">
            <div class="max-w-md w-full bg-slate-950/90 p-5 rounded-2xl border border-yellow-500/40 max-h-[90vh] flex flex-col">

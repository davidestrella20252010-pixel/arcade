        // --- BUCLE PRINCIPAL DEL JUEGO (GAME LOOP) ---
        function stepFrame() {
            if (gameState === 'PAUSED') return;
            if (hitStop > 0) { hitStop--; return; } // congelado breve al chocar
            const theme = LEVEL_THEMES[gameState === 'MENU' ? 0 : Math.min(currentLevelIndex, LEVEL_THEMES.length - 1)];
            beatPulse *= 0.9;
            ctx.save();
            ctx.fillStyle = theme.bg;
            ctx.fillRect(0, 0, VW, VH);

            if (screenShake > 0) {
                const dx = (Math.random() - 0.5) * screenShake;
                const dy = (Math.random() - 0.5) * screenShake;
                ctx.translate(dx, dy);
                screenShake *= 0.9;
                if (screenShake < 0.5) screenShake = 0;
            }

            // Fondo Neon Grid
            ctx.strokeStyle = 'rgba(' + theme.grid + ', ' + (0.05 + beatPulse * 0.07) + ')';
            ctx.lineWidth = 1;
            const gridSize = 40;
            for (let x = 0; x < VW; x += gridSize) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, VH);
                ctx.stroke();
            }
            for (let y = 0; y < VH; y += gridSize) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(VW, y);
                ctx.stroke();
            }

            if (gameState === 'PLAYING') {
                gameTime++;
                runFrames++;
                if (gameMode === 'daily' && !playerData.daily.played && runFrames >= DAILY_GOAL_FRAMES) claimDailyReward();
                if (gameMode === 'infinite' && !nearRecordShown && playerData.inf.times.length) {
                    const best = playerData.inf.times[0], now = runFrames / 60;
                    if (now < best && best - now <= 10) {
                        nearRecordShown = true;
                        toast('fa-bolt', '¡CASI!', 'Estás a menos de 10 s de tu mejor tiempo', '#fde047');
                    }
                }
                if (gameTime % 20 === 0) progressTick();
                updateMusicIntensity();
                gameScore += 0.1 * scoreMultiplier * dangerBonus() * mutScore();

                // Verificar avance de nivel
                checkLevelObjectives();
                if (gameState !== 'PLAYING') { // nivel completado: se corta el frame para que no haya colisiones ni daño
                    updateUI();
                    ctx.restore();
                    return;
                }

                // Dibujar Zonas Slime
                if (currentLevelIndex >= 1 || mut.slimy) {
                    slimeSpawnTimer--;
                    if (slimeSpawnTimer <= 0) {
                        if (hazmatZones.length < Math.min(6, currentLevelIndex + 2)) {
                            hazmatZones.push(new SlimeZone());
                        }
                        slimeSpawnTimer = 90 + Math.random() * 240; // entre 1.5 y 5.5 seg
                    }
                }
                for (let i = hazmatZones.length - 1; i >= 0; i--) {
                    const zone = hazmatZones[i];
                    zone.update();
                    zone.draw();
                    if (zone.isExpired()) hazmatZones.splice(i, 1);
                }

                // El combo se pierde si pasan 3 seg sin sumar nada
                if (comboTimer > 0) {
                    comboTimer--;
                    if (comboTimer === 0) breakCombo();
                }

                // El efecto de los cristales de peligro se acaba con el tiempo
                if (obstacleBoostTimer > 0) {
                    obstacleBoostTimer--;
                    if (obstacleBoostTimer === 0) obstacleBoostStage = 0;
                }

                // Spawn de Obstáculos
                // Cuenta regresiva en vez de gameTime % spawnRate: la cadencia no se descompasa cuando spawnRate baja
                const spawnRate = Math.max(mut.rain ? 12 : (currentLevelIndex >= 5 ? 10 : 15), Math.round((55 - Math.min(currentLevelIndex, 4) * 8 - Math.max(0, currentLevelIndex - 4) * 4 - Math.floor(gameTime / 300) - stageExtra() * 2) * (mut.rain ? 0.6 : 1)));
                obstacleSpawnTimer--;
                if (obstacleSpawnTimer <= 0) {
                    obstacles.push(new Obstacle());
                    obstacleSpawnTimer = spawnRate;
                }

                // Generar Cristales y Power-ups
                // Siempre debe haber cristales disponibles; los power-ups no pueden ocupar todo el espacio
                const gemCount = collectibles.filter(c => c.type === 'gem').length;
                const specialCount = collectibles.length - gemCount;
                if (gemCount < 3) {
                    collectibles.push(new Collectible('gem'));
                } else if (collectibles.length < 6 && Math.random() < 0.04) {
                    let randType = 'gem';
                    const randVal = Math.random();
                    if (randVal > 0.95 && playerLives < 3) randType = 'heart';
                    else if (randVal > 0.85 && currentLevelIndex >= 2) randType = 'turbo';
                    else if (randVal > 0.70) randType = 'multiplier';
                    else if (randVal > 0.58 && currentLevelIndex >= 1 &&
                             collectibles.filter(c => c.type === 'overclock').length < 2) randType = 'overclock';

                    if (randType !== 'gem' && specialCount >= 3) randType = 'gem';
                    collectibles.push(new Collectible(randType));
                }

                // Actualizar Jugador
                player.update();
                player.draw();
                drawShield();
                updateEnemies();

                // Obstáculos
                for (let i = obstacles.length - 1; i >= 0; i--) {
                    const obs = obstacles[i];
                    obs.update();
                    obs.draw();

                    const dist = Math.hypot(player.x - obs.x, player.y - obs.y);
                    const hitDist = sweptDist(player.px, player.py, player.x, player.y, obs.px, obs.py, obs.x, obs.y);
                    if (hitDist < player.radius + obs.size / 2) {
                        if (player.isDashing) {
                            playSound('hit');
                            for (let p = 0; p < 12; p++) {
                                particles.push(new Particle(obs.x, obs.y, '#ff0055', Math.random() * 5 + 2));
                            }
                            addScore(100, obs.x, obs.y, '#ff007f');
                            addCombo(2);
                            track('dashkills');
                            hitStop = 3;
                            rings.push(new Ring(obs.x, obs.y, '#ff007f', 60));
                            obstacles.splice(i, 1);
                            continue;
                        } else {
                            takeDamage();
                            obstacles.splice(i, 1);
                        }
                    }

                    const touchDist = player.radius + obs.size / 2;
                    if (!obs.grazed && player.invulnerableTimer <= 0 && (player.vx !== 0 || player.vy !== 0) &&
                        dist >= touchDist && dist < touchDist + grazeMargin()) {
                        obs.grazed = true;
                        registerGraze(obs);
                    }

                    // FASE 1: pasó a menos de PERFECT_GAP px y salió sin chocar = PIXEL PERFECT
                    const gapNow = dist - touchDist;
                    if (gapNow >= 0 && gapNow < PERFECT_GAP && player.invulnerableTimer <= 0 && !player.isDashing) {
                        if (!obs.close) { obs.close = true; slowMo(380); }
                    } else if (obs.close && !obs.perfect && gapNow >= PERFECT_GAP) {
                        obs.perfect = true;
                        registerPerfect(obs);
                    }

                    if (obs.isOutOfBounds()) {
                        obstacles.splice(i, 1);
                    }
                }

                // Coleccionables
                for (let i = collectibles.length - 1; i >= 0; i--) {
                    const item = collectibles[i];
                    item.update();
                    if (item.life !== undefined && item.life <= 0) {
                        collectibles.splice(i, 1);
                        continue;
                    }
                    item.draw();

                    const pickDist = sweptDist(player.px, player.py, player.x, player.y, item.x, item.y, item.x, item.y);
                    if (pickDist < player.radius + item.radius) {
                        if (item.type === 'gem') {
                            collectedGemsThisRun++;
                            track('gems');
                            if (perk('greed') && Math.random() < perk('greed') * 0.25) {
                                collectedGemsThisRun++;
                                track('gems');
                                floatingTexts.push(new FloatingText(item.x, item.y - 18, '¡DOBLE!', '#eab308'));
                            }
                            playSound('gem');
                            addScore(mut.harvest ? 40 : 10, item.x, item.y, '#eab308');
                            addCombo(1);
                        } else if (item.type === 'multiplier') {
                            playSound('powerup');
                            if (scoreMultiplier < MAX_SCORE_MULT) {
                                scoreMultiplier++;
                                floatingTexts.push(new FloatingText(item.x, item.y, 'x' + scoreMultiplier + (scoreMultiplier >= MAX_SCORE_MULT ? ' MAX' : '') + '!', '#a855f7'));
                            } else {
                                gameScore += 50; // con el multiplicador al tope, el orbe da puntos fijos
                                floatingTexts.push(new FloatingText(item.x, item.y, 'MAX x' + MAX_SCORE_MULT + ' +50', '#a855f7'));
                            }
                        } else if (item.type === 'turbo') {
                            player.turboTimer = 90; // 1.5 seg de súper velocidad
                            playSound('turbo');
                            floatingTexts.push(new FloatingText(item.x, item.y, 'TURBO!', '#3b82f6'));
                        } else if (item.type === 'overclock') {
                            obstacleBoostStage = Math.min(3, obstacleBoostStage + 1);
                            track('danger');
                            if (obstacleBoostStage >= 3) unlockAch('limit');
                            obstacleBoostTimer = 600; // 10 seg, se reinicia con cada cristal
                            screenShake = 8;
                            playSound('overclock');
                            floatingTexts.push(new FloatingText(item.x, item.y, '¡PELIGRO! PUNTOS x' + dangerBonus().toFixed(1), '#ff7a00'));
                        } else if (item.type === 'heart') {
                            if (playerLives < 3) playerLives++;
                            playSound('powerup');
                            floatingTexts.push(new FloatingText(item.x, item.y, '+1 VIDA', '#ef4444'));
                        }

                        for (let p = 0; p < 8; p++) {
                            particles.push(new Particle(item.x, item.y, item.color, Math.random() * 3 + 1));
                        }
                        collectibles.splice(i, 1);
                    }
                }

                // Partículas
                for (let i = particles.length - 1; i >= 0; i--) {
                    const p = particles[i];
                    p.update();
                    p.draw();
                    if (p.alpha <= 0) particles.splice(i, 1);
                }

                updateRings();

                // Textos Flotantes
                for (let i = floatingTexts.length - 1; i >= 0; i--) {
                    const t = floatingTexts[i];
                    t.update();
                    t.draw();
                    if (t.alpha <= 0) floatingTexts.splice(i, 1);
                }

                updateUI();
            } else {
                if (Math.random() < 0.05) {
                    particles.push(new Particle(Math.random() * VW, Math.random() * VH, '#00f3ff', Math.random() * 2));
                }
                for (let i = particles.length - 1; i >= 0; i--) {
                    const p = particles[i];
                    p.update();
                    p.draw();
                    if (p.alpha <= 0) particles.splice(i, 1);
                }
                updateRings();
            }

            ctx.restore();
            drawTouchUI();
        }

        // Paso fijo de 60 actualizaciones por segundo, sin importar los Hz del monitor
        const STEP_MS = 1000 / 60;
        let lastTime = 0;
        let accumulator = 0;

        function gameLoop(now) {
            requestAnimationFrame(gameLoop);
            if (!now) now = performance.now();
            if (!lastTime) lastTime = now;
            const slow = now < slowMoUntil ? 0.35 : 1; // 35% de velocidad durante la cámara lenta
            accumulator += Math.min(now - lastTime, 100) * slow;
            lastTime = now;
            while (accumulator >= STEP_MS) {
                stepFrame();
                accumulator -= STEP_MS;
            }
        }

        // --- MANEJO DE EVENTOS TECLADO & MOUSE ---
        const normKey = (e) => (e.key.length === 1 ? e.key.toLowerCase() : e.key);

        // El movimiento usa la posición física de la tecla (e.code): WASD queda igual en QWERTY, AZERTY, etc.
        const MOVE_CODES = {
            KeyW: 'w', KeyA: 'a', KeyS: 's', KeyD: 'd',
            ArrowUp: 'ArrowUp', ArrowDown: 'ArrowDown', ArrowLeft: 'ArrowLeft', ArrowRight: 'ArrowRight'
        };
        function moveKeyOf(e) {
            if (e.code) return MOVE_CODES[e.code] || null;
            const k = normKey(e); // teclados virtuales sin código físico: se usa el carácter
            return (k in keys && k !== ' ') ? k : null;
        }

        // Espacio es el Dash: no debe activar un botón enfocado (reiniciar o saltar de nivel por reflejo).
        // Enter sigue funcionando para quien navega con teclado, y R reinicia en Game Over.
        ['keydown', 'keyup'].forEach(type => window.addEventListener(type, (e) => {
            if (e.code === 'Space' && (gameState === 'GAMEOVER' || gameState === 'LEVEL_COMPLETE')) e.preventDefault();
        }, true));

        window.addEventListener('keydown', (e) => {
            const k = normKey(e);
            const mk = moveKeyOf(e);
            if (mk) keys[mk] = true;
            if (e.code === 'Space' && gameState === 'PLAYING' && player) {
                player.triggerDash();
                e.preventDefault();
            }
            if (e.repeat) return;
            if (e.key === 'Escape' || k === 'p') {
                if (gameState === 'PLAYING' || gameState === 'PAUSED') togglePause();
            } else if (k === 'r' && gameState === 'GAMEOVER') {
                startGame();
            }
        });

        window.addEventListener('keyup', (e) => {
            const mk = moveKeyOf(e);
            if (mk) keys[mk] = false;
        });

        window.addEventListener('blur', () => {
            for (const k in keys) keys[k] = false;
            pointerPos.isDown = false;
            movePointerId = null;
            resetStick();
            pauseGame(); // pausa sola si sales de la ventana
        });
        document.addEventListener('visibilitychange', () => {
            try {
                if (document.hidden) {
                    pauseGame();
                    transportWasRunning = Tone.Transport.state === 'started';
                    if (transportWasRunning) Tone.Transport.pause();
                } else if (transportWasRunning) {
                    Tone.Transport.start();
                    transportWasRunning = false;
                }
            } catch (e) {
                if (document.hidden) pauseGame();
            }
        });

        // Mouse/lápiz: un solo puntero controla el movimiento ("ir hacia el clic")
        let movePointerId = null;

        window.addEventListener('pointermove', (e) => {
            if (e.pointerType === 'touch') {
                // Joystick flotante: si el dedo se aleja más del radio, la base lo sigue
                if (e.pointerId !== stick.id) return;
                stick.x = e.clientX;
                stick.y = e.clientY;
                const vx = stick.x - stick.ox, vy = stick.y - stick.oy;
                const l = Math.hypot(vx, vy);
                if (l > STICK_R) {
                    stick.ox = stick.x - vx / l * STICK_R;
                    stick.oy = stick.y - vy / l * STICK_R;
                }
                return;
            }
            if (movePointerId !== null && e.pointerId !== movePointerId) return;
            pointerPos.x = e.clientX;
            pointerPos.y = e.clientY;
        });

        // Dash por toque: no hace falta apuntar a nada, cualquier lugar del lado del Dash sirve
        let lastBlockedFx = 0;
        function dashBlockedFeedback() {
            const t = performance.now();
            if (t - lastBlockedFx < 600) return;
            lastBlockedFx = t;
            vibrate(10);
            if (player) floatingTexts.push(new FloatingText(player.x - 50, player.y - 30, 'SIN CRISTALES', '#94a3b8', 14));
            const b = document.getElementById('mobile-dash-btn');
            b.classList.remove('nv-shake'); void b.offsetWidth; b.classList.add('nv-shake');
        }

        window.addEventListener('pointerdown', (e) => {
            if (e.target.closest('button')) return;

            if (e.pointerType === 'touch') {
                if (gameState !== 'PLAYING' || !player) return;
                if (isMoveSide(e.clientX)) {
                    if (stick.id === null) {
                        stick.id = e.pointerId;
                        stick.ox = stick.x = e.clientX;
                        stick.oy = stick.y = e.clientY;
                    }
                } else {
                    player.triggerDash();
                }
                return;
            }

            if (movePointerId === null) {
                movePointerId = e.pointerId;
                pointerPos.isDown = true;
                pointerPos.x = e.clientX;
                pointerPos.y = e.clientY;
            }

            if (e.button === 2 && gameState === 'PLAYING' && player) {
                player.triggerDash();
            }
        });

        function releasePointer(e) {
            if (e.pointerId === stick.id) resetStick();
            if (e.pointerId !== movePointerId) return;
            movePointerId = null;
            pointerPos.isDown = false;
        }
        window.addEventListener('pointerup', releasePointer);
        window.addEventListener('pointercancel', releasePointer); // el sistema canceló el toque (gesto, notificación)

        window.addEventListener('contextmenu', (e) => e.preventDefault());

        // pointerdown responde al instante (click espera al soltar el dedo)
        document.getElementById('mobile-dash-btn').addEventListener('pointerdown', (e) => {
            e.stopPropagation();
            e.preventDefault();
            if (gameState === 'PLAYING' && player) {
                player.triggerDash();
            }
        });

        // El botón DASH solo se ve mientras se juega (no sobre el menú, la pausa ni los avisos)
        function setDashButton(visible) {
            document.getElementById('mobile-controls').classList.toggle('hidden', !visible);
            if (!visible) resetStick();
        }

        // Posición del botón DASH según la mano: en modo zurdo los lados se invierten
        function applyHandedness() {
            const mc = document.getElementById('mobile-controls');
            mc.style.right = leftHanded ? 'auto' : '24px';
            mc.style.left = leftHanded ? '24px' : 'auto';
        }
        function refreshHandButtons() {
            document.querySelectorAll('.js-hand-toggle').forEach(b => {
                b.querySelector('span').textContent = 'MODO ZURDO: ' + (leftHanded ? 'SÍ' : 'NO');
                b.classList.toggle('opacity-50', !leftHanded);
            });
        }
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.js-hand-toggle')) return;
            leftHanded = !leftHanded;
            lsSet('nv_lefty', leftHanded ? '1' : '0');
            resetStick();
            applyHandedness();
            refreshHandButtons();
        });

        // Estado visual del botón DASH: anillo de enfriamiento, usos restantes y bloqueo
        let lastDashBtnKey = '';
        function updateDashButton() {
            if (!player) return;
            const ready = player.dashCooldown <= 0;
            const pct = ready ? 100 : Math.round(100 - player.dashCooldown / player.dashCooldownMax * 100);
            const locked = dashCharges <= 0 && collectedGemsThisRun <= 0;
            const uses = dashCharges > 0 ? dashCharges : (collectedGemsThisRun > 0 ? 2 : 0);
            const key = pct + '|' + locked + '|' + uses;
            if (key === lastDashBtnKey) return;
            lastDashBtnKey = key;
            const ring = document.getElementById('dash-btn-ring');
            const sub = document.getElementById('dash-btn-sub');
            const lab = document.getElementById('dash-btn-label');
            const btn = document.getElementById('mobile-dash-btn');
            if (locked) {
                ring.style.background = 'rgba(100,116,139,0.45)';
                btn.style.boxShadow = 'none';
                lab.style.opacity = '0.4';
                sub.textContent = 'BLOQ.';
                sub.style.color = '#94a3b8';
            } else {
                ring.style.background = 'conic-gradient(' + (ready ? '#ff2e97' : '#00f3ff') + ' ' + pct + '%, rgba(51,65,85,0.9) 0)';
                btn.style.boxShadow = ready ? '0 0 18px rgba(255,46,151,0.7)' : 'none';
                lab.style.opacity = ready ? '1' : '0.6';
                sub.textContent = '×' + uses;
                sub.style.color = '#7df9ff';
            }
        }

        // Joystick dibujado sobre el canvas (solo mientras hay un dedo apoyado)
        function drawTouchUI() {
            if (stick.id === null || gameState !== 'PLAYING') return;
            const vx = stick.x - stick.ox, vy = stick.y - stick.oy;
            const l = Math.hypot(vx, vy);
            const k = l > STICK_R ? STICK_R / l : 1;
            ctx.save();
            ctx.lineWidth = 3;
            ctx.strokeStyle = '#00f3ff';
            ctx.globalAlpha = 0.35;
            ctx.beginPath();
            ctx.arc(stick.ox, stick.oy, STICK_R, 0, Math.PI * 2);
            ctx.stroke();
            ctx.globalAlpha = 0.6;
            ctx.fillStyle = '#00f3ff';
            ctx.beginPath();
            ctx.arc(stick.ox + vx * k, stick.oy + vy * k, 22, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }

        // --- REGISTRO DE BOTONES DE LA INTERFAZ ---
        document.getElementById('btn-start').addEventListener('click', () => {
            startGame('campaign');
        });

        document.getElementById('btn-restart').addEventListener('click', () => {
            startGame();
        });

        document.getElementById('btn-next-level').addEventListener('click', () => {
            nextLevel();
        });

        function blurFocus() {
            if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
        }

        function pauseGame() {
            if (gameState !== 'PLAYING') return;
            gameState = 'PAUSED';
            musicMuffle(true);
            setMusicMood(0);
            renderPerkList();
            pausedUI.classList.remove('hidden');
            setDashButton(false);
            document.getElementById('btn-resume').focus();
        }

        function resumeGame() {
            if (gameState !== 'PAUSED') return;
            gameState = 'PLAYING';
            pausedUI.classList.add('hidden');
            setDashButton(true);
            lastTime = 0;
            accumulator = 0;
            musicMuffle(false);
            blurFocus();
        }

        function togglePause() {
            if (gameState === 'PLAYING') pauseGame();
            else if (gameState === 'PAUSED') resumeGame();
        }

        document.getElementById('btn-pause').addEventListener('click', pauseGame);
        document.getElementById('btn-resume').addEventListener('click', resumeGame);
        // Al salir desde la pausa se guardan los cristales y el récord del nivel en curso
        function bankRunProgress() {
            if (!player) return;
            playerData.gems += collectedGemsThisRun;
            collectedGemsThisRun = 0;
            const total = bankedScore + Math.floor(gameScore);
            recordScore(total);
            trackMax('score', total);
            checkAchievements();
            savePlayerData();
        }
        document.getElementById('btn-pause-restart').addEventListener('click', () => { bankRunProgress(); startGame(); });
        document.getElementById('btn-pause-menu').addEventListener('click', () => { bankRunProgress(); goToMenu(); });

        function goToMenu() {
            pausedUI.classList.add('hidden');
            musicMuffle(false);
            setMusicMood(0);
            gameState = 'MENU';
            infAttemptStreak = 0;
            gameOverUI.classList.add('hidden');
            levelCompleteUI.classList.add('hidden');
            menuUI.classList.remove('hidden');
            hudUI.classList.add('opacity-0');
            setDashButton(false);
            updateUI();
            updateMenuBadges();
            updateModeStats();
            document.getElementById('btn-start').focus();
        }
        document.getElementById('btn-menu').addEventListener('click', goToMenu);

        // ================= MODO INFINITO Y RETO DIARIO =================
        const WAVE_FRAMES = 2400; // cada oleada dura 40 seg
        function isEndless() { return gameMode !== 'campaign'; }
        function stageExtra() { return isEndless() ? Math.min(10, Math.max(0, infStage - 4)) : 0; }
        function mutScore() { return mut.glass ? 2 : 1; }

        // Cada día se eligen 2 modificadores al azar (iguales para todos los jugadores ese día)
        const MUTATORS = [
            { id: 'rain',    icon: 'fa-cloud-rain',  name: 'Lluvia',            desc: 'Los cuadrados rojos aparecen mucho más seguido' },
            { id: 'swift',   icon: 'fa-gauge-high',  name: 'Enemigos veloces',  desc: 'Todos los enemigos van 25% más rápido' },
            { id: 'glass',   icon: 'fa-heart-crack', name: 'Cristal frágil',    desc: 'Solo tienes 1 vida, pero los puntos valen el doble' },
            { id: 'hunt',    icon: 'fa-crosshairs',  name: 'Cacería',           desc: 'Los perseguidores aparecen desde el inicio' },
            { id: 'harvest', icon: 'fa-seedling',    name: 'Cosecha',           desc: 'Cada cristal da 4 veces más puntos' },
            { id: 'slimy',   icon: 'fa-droplet',     name: 'Pantano',           desc: 'Las manchas viscosas aparecen desde el inicio' }
        ];
        function dailyMutators() {
            const rnd = mulberry32(hashStr('nv-mut-' + todayKey()));
            const pool = MUTATORS.slice();
            for (let i = pool.length - 1; i > 0; i--) {
                const j = Math.floor(rnd() * (i + 1));
                [pool[i], pool[j]] = [pool[j], pool[i]];
            }
            const o = {};
            pool.slice(0, 2).forEach(m => { o[m.id] = true; });
            return o;
        }
        function dailyMutList() {
            const m = dailyMutators();
            return MUTATORS.filter(x => m[x.id]);
        }

        function yesterdayKey() {
            const d = new Date();
            d.setDate(d.getDate() - 1);
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }
        function ensureDaily() {
            const d = playerData.daily;
            const key = todayKey();
            if (d.date !== key) { d.date = key; d.best = 0; d.played = false; }
        }
        function currentStreak() {
            const d = playerData.daily;

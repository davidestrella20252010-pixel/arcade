        // --- BARRAS DE OBJETIVO ---
        let objRows = [];
        function buildObjectiveBars() {
            const c = LEVEL_CONFIGS[currentLevelIndex];
            const defs = [
                { key: 'gems', label: 'Cristales', icon: 'fa-gem', target: c.targetGems },
                { key: 'score', label: 'Puntos', icon: 'fa-star', target: c.targetScore }
            ];
            if (c.targetTime > 0) {
                defs.push({ key: 'time', label: 'Tiempo (seg)', icon: 'fa-clock', target: Math.round(c.targetTime / 60) });
            }
            if (c.boss) defs.push({ key: 'boss', label: 'Jefe: ' + c.boss.name, icon: 'fa-skull', target: c.boss.hp });
            if (isEndless()) {
                defs.length = 0;
                defs.push({ key: 'wave', label: 'Oleada', icon: 'fa-wave-square', target: Math.round(WAVE_FRAMES / 60) });
            }
            document.getElementById('objective-title').innerText = gameMode === 'daily' ? 'RETO DIARIO' : (gameMode === 'infinite' ? 'MODO INFINITO' : 'OBJETIVO DE NIVEL');
            document.getElementById('level-label').innerText = isEndless() ? 'Oleada' : 'Nivel';
            objectiveDisplay.innerHTML = defs.map(d => `
                <div data-row="${d.key}">
                    <div class="flex justify-between text-[11px] leading-none mb-1">
                        <span><i class="fa-solid ${d.icon} mr-1"></i><span data-label>${d.label}</span></span>
                        <span data-val></span>
                    </div>
                    <div class="h-1.5 bg-slate-800 rounded-full overflow-hidden">
                        <div data-fill class="h-full bg-cyan-400 rounded-full transition-all duration-100" style="width:0%"></div>
                    </div>
                </div>`).join('');
            objRows = defs.map(d => {
                const el = objectiveDisplay.querySelector(`[data-row="${d.key}"]`);
                return { key: d.key, target: d.target, lab: el.querySelector('[data-label]'), val: el.querySelector('[data-val]'), fill: el.querySelector('[data-fill]') };
            });
        }

        function updateObjectiveBars() {
            objRows.forEach(r => {
                if (r.key === 'wave') {
                    r.lab.textContent = 'Oleada ' + (infStage + 1);
                    r.val.textContent = Math.floor(waveTimer / 60) + ' / ' + r.target + ' s';
                    r.fill.style.width = Math.min(100, waveTimer / WAVE_FRAMES * 100) + '%';
                    r.fill.className = 'h-full rounded-full transition-all duration-100 bg-pink-400';
                    return;
                }
                const cur = r.key === 'gems' ? collectedGemsThisRun
                          : r.key === 'score' ? Math.floor(gameScore)
                          : r.key === 'boss' ? bossHits
                          : Math.floor(gameTime / 60);
                const done = cur >= r.target;
                r.val.textContent = (done ? '✓ ' : '') + Math.min(cur, r.target) + ' / ' + r.target;
                r.fill.style.width = Math.min(100, cur / r.target * 100) + '%';
                r.fill.className = 'h-full rounded-full transition-all duration-100 ' + (done ? 'bg-emerald-400' : 'bg-cyan-400');
            });
        }


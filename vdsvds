        // Ruleta al cambiar de nivel: 30% de vida extra. Si las vidas están llenas, da un escudo.
        function rollLifeRoulette() {
            if (Math.random() >= 0.30) {
                toast('fa-xmark', 'SIN SUERTE', 'No te tocó la vida extra en este nivel', '#94a3b8');
                floatingTexts.push(new FloatingText(player.x, player.y - 40, 'SIN SUERTE', '#94a3b8', 20));
                return;
            }
            if (playerLives < 3) {
                playerLives++;
                toast('fa-heart', 'VIDA EXTRA', '¡Ganaste 1 vida!', '#ef4444');
                floatingTexts.push(new FloatingText(player.x, player.y - 40, 'VIDA EXTRA', '#ef4444', 20));
            } else {
                runShields++;
                toast('fa-shield-halved', 'VIDA EXTRA', 'Vidas llenas: recibiste un escudo', '#7df9ff');
                floatingTexts.push(new FloatingText(player.x, player.y - 40, 'VIDA EXTRA: ESCUDO', '#7df9ff', 20));
            }
        }

        function nextLevel() {
            if (isEndless()) { resumeNextWave(); return; }
            if (currentLevelIndex >= LEVEL_CONFIGS.length - 1) { goToMenu(); return; }
            if (perkChoices.length && perkPicked === null) return; // primero hay que elegir una mejora
            applyPerk();
            currentLevelIndex++;
            resetGame(false); // Mantener vidas y pasar de nivel
            rollLifeRoulette();
            gameState = 'PLAYING';
            blurFocus();
            levelCompleteUI.classList.add('hidden');
            setDashButton(true);
            updateUI();
        }

        function takeDamage() {
            if (gameState !== 'PLAYING') return; // no se pierde vida si el nivel ya se completó o la partida terminó
            if (player.invulnerableTimer > 0) return;

            if (runShields > 0) {
                runShields--;
                player.invulnerableTimer = 45;
                screenShake = 6;
                playSound('powerup');
                vibrate(30);
                rings.push(new Ring(player.x, player.y, '#7df9ff', 110, 4));
                floatingTexts.push(new FloatingText(player.x - 30, player.y - 30, '¡ESCUDO!', '#7df9ff'));
                for (let p = 0; p < 12; p++) particles.push(new Particle(player.x, player.y, '#7df9ff', Math.random() * 5 + 2));
                return;
            }

            levelDamageTaken = true;
            playerLives--;
            breakCombo();
            playSound('hit');
            screenShake = 15;
            hitStop = 6;
            vibrate(70);
            rings.push(new Ring(player.x, player.y, '#ff0055', 130, 4));
            player.invulnerableTimer = 60 + perk('grace') * 40; // 1 segundo de gracia

            for (let p = 0; p < 20; p++) {
                particles.push(new Particle(player.x, player.y, '#ff0055', Math.random() * 6 + 2));
            }

            if (playerLives <= 0) {
                triggerGameOver();
            }
        }

        function triggerGameOver() {
            gameState = 'GAMEOVER';
            playSound('gameover');
            screenShake = 25;
            slowMo(900, true); // explosión final en cámara lenta
            vibrate([120, 60, 220]);
            musicMuffle(true);
            setMusicMood(0);
            const boom = Math.round(45 * FX);
            for (let i = 0; i < boom; i++) {
                particles.push(new Particle(player.x, player.y, i % 2 ? '#ff0055' : '#00f3ff', Math.random() * 9 + 2));
            }
            rings.push(new Ring(player.x, player.y, '#ff0055', 260, 5));
            rings.push(new Ring(player.x, player.y, '#00f3ff', 180, 3));

            const prevHigh = runStartHighScore;
            const totalScore = bankedScore + Math.floor(gameScore);
            const gainedGems = bankedGems + collectedGemsThisRun;
            playerData.gems += collectedGemsThisRun;
            recordScore(totalScore);
            const dailyBonus = gameMode === 'daily' ? dailyRewardThisRun : 0;

            // Tiempo de supervivencia (modo infinito): top 3 de mejores tiempos
            lastRunSec = Math.round(runFrames / 6) / 10;
            lastTimeRank = 0;
            if (gameMode === 'infinite' && lastRunSec > 0) {
                const list = playerData.inf.times.concat(lastRunSec).sort((a, b) => b - a).slice(0, 3);
                lastTimeRank = list.indexOf(lastRunSec) + 1;
                playerData.inf.times = list;
            }
            savePlayerData();

            trackMax('score', totalScore);
            checkAchievements();
            savePlayerData();

            document.getElementById('final-score').innerText = totalScore;
            document.getElementById('best-score-gameover').innerText = modeBest();
            document.getElementById('gained-gems').innerText = '+' + gainedGems;
            
            hudUI.classList.add('opacity-0');
            setDashButton(false);
            document.getElementById('new-record').classList.toggle('hidden', !(totalScore > prevHigh && totalScore > 0));
            // FASE 1: "te faltaron X" (solo si estuviste a partir del 50% de tu récord)
            const nearRec = document.getElementById('near-record');
            const missing = prevHigh - totalScore + 1;
            const showNear = prevHigh > 0 && totalScore <= prevHigh && totalScore >= prevHigh * 0.5;
            nearRec.classList.toggle('hidden', !showNear);
            if (showNear) nearRec.innerText = `¡Te faltaron ${missing} puntos para superar tu récord!`;
            document.getElementById('reached-level').innerText = isEndless() ? infStage + 1 : currentLevelIndex + 1;
            document.getElementById('reached-label').innerText = isEndless() ? 'Oleada alcanzada' : 'Nivel alcanzado';
            const dr = document.getElementById('daily-reward');
            dr.classList.toggle('hidden', gameMode !== 'daily');
            if (gameMode === 'daily') {
                dr.innerText = dailyBonus
                    ? `PREMIO DIARIO: +${dailyBonus} CRISTALES · RACHA ${playerData.daily.streak}`
                    : 'RETO NO COMPLETADO: sobrevive 3 minutos para el premio';
            }

            // Panel de tiempos (solo modo infinito)
            const infBox = document.getElementById('inf-times');
            infBox.classList.toggle('hidden', gameMode !== 'infinite');
            if (gameMode === 'infinite') {
                const times = playerData.inf.times;
                document.getElementById('inf-times-list').innerHTML = times.map((t, i) => {
                    const mine = i + 1 === lastTimeRank;
                    return `<div class="flex justify-between ${mine ? 'text-yellow-300 font-bold' : 'text-slate-300'}"><span>#${i + 1}</span><span>${fmtTime(t)}</span></div>`;
                }).join('') || '<div class="text-slate-500">Sin tiempos todavía</div>';
                const base = `Tu partida: ${fmtTime(lastRunSec)}`;
                let line;
                if (lastTimeRank === 1) line = `${base} · ¡NUEVO MEJOR TIEMPO!`;
                else if (lastTimeRank > 0) line = `${base} · puesto #${lastTimeRank} del top 3`;
                else line = `${base} · te faltaron ${(times[2] - lastRunSec).toFixed(1)} s para entrar al top 3`;
                document.getElementById('inf-run-line').innerText = line;
                document.getElementById('inf-streak-line').innerText = `Partida ${infAttemptStreak} seguida sin volver al menú`;
            }
            document.getElementById('best-combo').innerText = bestComboRun;
            document.getElementById('graze-count').innerText = grazeCount;
            // FASE 2: datos de la última partida, ordenados en un solo objeto (base para las tarjetas compartibles)
            playerData.lastRun = {
                name: playerName(),
                mode: gameMode,
                score: totalScore,
                stage: isEndless() ? infStage + 1 : currentLevelIndex + 1,
                combo: bestComboRun,
                grazes: grazeCount,
                gems: gainedGems,
                sec: Math.round(runFrames / 60),
                dailyDone: dailyBonus > 0,
                date: todayKey()
            };
            savePlayerData();
            shareBlobPromise = buildShareCard(playerData.lastRun).catch(() => null); // FASE 3: se prepara en segundo plano
            // La pantalla aparece después de la explosión
            setTimeout(() => {
                if (gameState === 'GAMEOVER') gameOverUI.classList.remove('hidden');
            }, 800);
            setTimeout(() => { if (gameState === 'GAMEOVER') document.getElementById('btn-restart').focus(); }, 1500);
        }


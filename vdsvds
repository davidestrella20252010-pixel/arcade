        function hashStr(s) { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; }
        function mulberry32(a) {
            return function () {
                a |= 0; a = a + 0x6D2B79F5 | 0;
                let t = Math.imul(a ^ a >>> 15, 1 | a);
                t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
                return ((t ^ t >>> 14) >>> 0) / 4294967296;
            };
        }
        function todayKey() {
            const d = new Date();
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }

        function ensureMissions() {
            const ms = playerData.missions;
            const key = todayKey();
            if (ms && ms.date === key && Array.isArray(ms.list) && ms.list.length) return;
            const rnd = mulberry32(hashStr('nv-' + key));
            const pool = MISSION_POOL.slice();
            for (let i = pool.length - 1; i > 0; i--) {
                const j = Math.floor(rnd() * (i + 1));
                [pool[i], pool[j]] = [pool[j], pool[i]];
            }
            const list = pool.slice(0, 3).map(t => {
                const tier = Math.floor(rnd() * 3);
                return { key: t.key, target: t.targets[tier], reward: MISSION_REWARDS[tier], progress: 0, done: false, claimed: false };
            });
            playerData.missions = { date: key, list: list, bonus: false };
            savePlayerData();
        }


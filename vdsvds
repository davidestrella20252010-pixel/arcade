                <div class="text-[11px] text-slate-300 truncate">${sub}</div></div>`;
            wrap.appendChild(el);
            requestAnimationFrame(() => el.classList.add('show'));
            setTimeout(() => { el.classList.remove('show'); setTimeout(() => el.remove(), 300); }, 3200);
        }

        // --- Registro de estadísticas ---
        function missionProgress(stat, v, isMax) {
            const ms = playerData.missions;
            if (!ms || !Array.isArray(ms.list)) return;
            for (const m of ms.list) {
                const t = missionTpl(m.key);
                if (!t || t.key !== stat || m.done) continue;
                if ((t.mode === 'max') !== isMax) continue;
                m.progress = isMax ? Math.max(m.progress, v) : m.progress + v;
                statsDirty = true;
                if (m.progress >= m.target) {
                    m.progress = m.target;
                    m.done = true;
                    toast('fa-bullseye', '¡MISIÓN COMPLETA!', t.text(m.target), '#34d399');
                    playSound('powerup');
                }
            }
        }
        function track(stat, n) {
            n = n === undefined ? 1 : n;
            playerData.stats[stat] = (playerData.stats[stat] || 0) + n;
            statsDirty = true;
            missionProgress(stat, n, false);
        }
        function trackMax(stat, v) {
            const k = 'best_' + stat;
            if (v > (playerData.stats[k] || 0)) { playerData.stats[k] = v; statsDirty = true; }

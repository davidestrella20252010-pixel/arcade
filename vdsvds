                targetGems: 15,
                targetScore: 700,
                targetTime: 20 * 60, // 20 seg
                description: "Nivel 3: aparecen los Perseguidores (triángulos fucsia que giran hacia ti) y los Orbes Turbo azules."
            },
            {
                title: "NIVEL 3: TURBO CAOS",
                targetGems: 20,
                targetScore: 1200,
                targetTime: 0,
                description: "Nivel 4: Bombas divisoras (hexágonos verdes) que estallan en 4 fragmentos. ¡Desactívalas con Dash antes de que exploten!"
            },
            {
                title: "NIVEL 4: TORMENTA DE PLASMA",
                targetGems: 25,
                targetScore: 2000,
                targetTime: 0,
                description: "¡Nivel 5, el final! Láseres que cruzan la pantalla: avisan con una línea punteada antes de disparar."
            },
            {
                title: "NIVEL 5: HIPERESPACIO FINAL",
                targetGems: 35,
                targetScore: 3000,
                targetTime: 35 * 60,
                description: "Nivel 6: aparece el primer Jefe. Cuando cumplas los objetivos, se activa: golpéalo con Dash para derribarlo."
            },
            {
                title: "NIVEL 6: FRACTURA ÁMBAR",
                targetGems: 40,
                targetScore: 3600,
                targetTime: 40 * 60,
                description: "Nivel 7: el Enjambre. Los jefes disparan directo hacia ti e invocan Perseguidores.",
                boss: { name: "GUARDIÁN ÁMBAR", hp: 6, color: "#ff8c00", patterns: ["ring"] }
            },
            {
                title: "NIVEL 7: ENJAMBRE PRISMA",
                targetGems: 45,
                targetScore: 4300,
                targetTime: 45 * 60,
                description: "Nivel 8: muros de proyectiles con un hueco que se mueve, y dos láseres a la vez. Con Dash destruyes los proyectiles.",
                boss: { name: "ENJAMBRE PRISMA", hp: 8, color: "#a3ff12", patterns: ["aimed", "summon"] }
            },
            {
                title: "NIVEL 8: CENTINELA VOLTA",
                targetGems: 50,
                targetScore: 5000,
                targetTime: 50 * 60,
                description: "Nivel 9: los jefes combinan muros, abanicos e invocaciones.",
                boss: { name: "CENTINELA VOLTA", hp: 9, color: "#60a5fa", patterns: ["wall", "aimed"] }
            },
            {
                title: "NIVEL 9: NÚCLEO CROMADO",
                targetGems: 55,
